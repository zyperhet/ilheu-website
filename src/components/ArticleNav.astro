---
interface Props {
  next?: { label: string; href: string };
  dark?: boolean;
}
const { next, dark = false } = Astro.props;

const base = dark
  ? 'text-gray-500 hover:text-white'
  : 'text-gray-400 hover:text-gray-900';
---

<nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
  <!-- Back (history-based with fallback) -->
  <button
    type="button"
    class:list={['article-back group flex items-center gap-2 font-inter text-sm transition-colors cursor-pointer', base]}
  >
    <span class="text-base group-hover:-translate-x-1 transition-transform">&larr;</span>
    <span class="hidden sm:inline">Back</span>
  </button>

  <!-- Next -->
  {next && (
    <a
      href={next.href}
      class:list={['group flex items-center gap-2 font-inter text-sm transition-colors', base]}
    >
      <span class="hidden sm:inline">{next.label}</span>
      <span class="text-base group-hover:translate-x-1 transition-transform">&rarr;</span>
    </a>
  )}
</nav>

<script>
  document.querySelectorAll('.article-back').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (
        document.referrer &&
        new URL(document.referrer).origin === window.location.origin
      ) {
        history.back();
      } else {
        window.location.href = '/editions/edition-2';
      }
    });
  });
</script>
