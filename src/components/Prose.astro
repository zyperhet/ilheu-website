---
// Prose.astro
// Typography wrapper component applying @tailwindcss/typography prose classes to slot content.
// Used to wrap rendered Markdown (Content) from Astro content collections.
---

<div
  class="prose prose-lg max-w-none
    prose-headings:font-cardo
    prose-a:text-current prose-a:underline-offset-2
    prose-blockquote:border-l-gray-400 prose-blockquote:text-gray-700 prose-blockquote:font-normal
    prose-strong:font-semibold
    prose-img:rounded-none"
>
  <slot />
</div>
