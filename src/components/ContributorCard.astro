---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  contributor: CollectionEntry<'contributors'>;
}

const { contributor } = Astro.props;
---

<div class="flex items-center gap-3">
  <div class="shrink-0">
    {contributor.data.portrait ? (
      <Image
        src={contributor.data.portrait}
        alt={contributor.data.name}
        class="w-12 h-12 rounded-full object-cover"
        width={48}
        height={48}
      />
    ) : (
      <div class="w-12 h-12 rounded-full bg-gray-200 flex items-center justify-center">
        <span class="text-sm font-medium text-gray-500">
          {contributor.data.name[0]}
        </span>
      </div>
    )}
  </div>
  <div>
    <p class="text-sm font-medium text-gray-900">{contributor.data.name}</p>
    <p class="text-xs text-gray-500">{contributor.data.role}</p>
  </div>
</div>
