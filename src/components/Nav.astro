---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Issue B', href: '/editions/edition-2', accent: true },
  { label: 'About', href: '/about' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="border-b border-gray-200">
  <div class="max-w-5xl mx-auto px-4">

    <!-- Logo / Magazine Name -->
    <div class="py-5 text-center">
      <a
        href="/"
        class="font-cardo text-2xl tracking-widest uppercase text-gray-900 hover:text-gray-600 transition-colors"
      >
        Ilhéu
      </a>
    </div>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex justify-center items-center gap-8 py-3 border-t border-gray-200">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`text-sm uppercase tracking-wider transition-colors ${
            isActive(item.href)
              ? 'font-semibold underline underline-offset-4' + (item.accent ? ' text-[#1B3A5C]' : ' text-gray-900')
              : item.accent
                ? 'text-[#1B3A5C] hover:text-[#132a44] font-medium'
                : 'text-gray-600 hover:text-gray-900'
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Mobile Nav -->
    <div class="md:hidden">
      <!-- Hamburger button -->
      <div class="flex justify-end py-3 border-t border-gray-200">
        <button
          id="menu-btn"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          class="text-gray-700 hover:text-gray-900 p-1"
        >
          <!-- Hamburger icon (shown when menu is closed) -->
          <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Close icon (shown when menu is open) -->
          <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Mobile menu (hidden by default) -->
      <nav id="mobile-menu" class="hidden flex-col items-center gap-4 py-4 border-t border-gray-200">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`text-sm uppercase tracking-wider transition-colors ${
              isActive(item.href)
                ? 'font-semibold underline underline-offset-4' + (item.accent ? ' text-[#1B3A5C]' : ' text-gray-900')
                : item.accent
                  ? 'text-[#1B3A5C] hover:text-[#132a44] font-medium'
                  : 'text-gray-600 hover:text-gray-900'
            }`}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>

  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  if (btn && menu && iconOpen && iconClose) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      menu.classList.toggle('flex');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }
</script>
