        Worldwide shipping available. Secure checkout via Stripe.
      </p>
    </div>
  </section>

  <script>
    const content = document.getElementById('editorial-content');
    const fade = document.getElementById('editorial-fade');
    const btn = document.getElementById('editorial-toggle');

    if (content && fade && btn) {
      let expanded = false;

      btn.addEventListener('click', () => {
        expanded = !expanded;
        if (expanded) {
          content.style.maxHeight = content.scrollHeight + 'px';
          fade.style.opacity = '0';
          btn.textContent = 'Show less';
        } else {
          content.style.maxHeight = '28rem';
          fade.style.opacity = '1';
          btn.textContent = 'Continue reading';
        }
      });
    }
  </script>

