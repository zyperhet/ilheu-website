---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';

// Covers
import coverImage from '../../../assets/images/00-covers/front-cover-full-page.png';
import coverIssueA from '../../../assets/images/00-covers/cover-issue-a.png';

// Contents images
import imgDacosta from '../../../assets/images/01-antonio-dacosta-conversation/dacosta-eyelids.jpg';
import imgDacostaEssay from '../../../assets/images/06-dacosta-picture-essay-artworks/dacosta-memory-v-1982-acrylic-collage-wax-crayon.jpg';
import imgLeila from '../../../assets/images/02-leila-slimani-conversation/leila-slimani-portrait-golden-light-blue-shirt.jpg';
import imgRomeu from '../../../assets/images/03-azorean-blues-conversation/romeu-bairos-portrait-with-viola-da-terra.jpg';
import imgPool from '../../../assets/images/04-pool-at-edge-of-world-architecture/povoacao-pool-diving-platform-lanes-interior.jpg';
import imgBlueAzores from '../../../assets/images/05-blue-azores-environment/blue-azores-jellyfish-underwater-nelson-raposo.jpg';
import imgComic from '../../../assets/images/10-comic-strip/comic-strip-sara-azad-ponta-delgada.png';

// Playlist backgrounds
import imgPlaylistSoundOfBlue from '../../../assets/images/03-azorean-blues-conversation/azores-landscape-opa-collective-playlist.jpg';
import imgPlaylistAzoreanBlues from '../../../assets/images/03-azorean-blues-conversation/romeu-bairos-viola-da-terra-close-up.jpg';

const edition = await getEntry('editions', 'edition-2');
const purchaseUrl = edition?.data.purchase_url ?? '#';
const accentColour = '#1B3A5C';

// Previous issue (Azores) — sold out, no link
const allEditions = await getCollection('editions');
const previousIssue = allEditions.find((e) => e.data.status === 'archive');

const conversations = [
  {
    category: 'Art',
    title: 'Antonio Dacosta and His Paris Blues',
    contributors: 'Urbano Resendes, Arlete Alves da Silva',
    pages: '12–25',
    image: imgDacosta,
    alt: 'António Dacosta, eyelids — detail',
    href: '/conversations/dacosta',
  },
  {
    category: 'Writing',
    title: "What’s the point trying to understand a soul?",
    contributors: 'Maria Brandao, Leila Slimani',
    pages: '50–63',
    image: imgLeila,
    alt: 'Leila Slimani, portrait in golden light wearing blue shirt',
    href: '/conversations/slimani',
  },
  {
    category: 'Music',
    title: 'Azorean Blues',
    contributors: 'Diogo Lima, Romeu Bairos',
    pages: '66–76',
    image: imgRomeu,
    alt: 'Romeu Bairos, portrait with viola da terra',
    href: '/conversations/azorean-blues',
  },
  {
    category: 'Architecture',
    title: 'The Pool at the Edge of the World',
    contributors: 'Ilheu Atelier, Jose Antonio Barbosa',
    pages: '82–95',
    image: imgPool,
    alt: 'Povoacao municipal swimming pool, abandoned interior with diving platform and lanes',
    href: '/conversations/pool',
  },
  {
    category: 'Environment',
    title: 'Blue Azores',
    contributors: 'Adriano Quintela, Bernardo Brito e Abreu',
    pages: '100–111',
    image: imgBlueAzores,
    videoSrc: '/videos/blue-jellyfish.mp4',
    alt: 'Blue Azores jellyfish underwater, photograph by Nelson Raposo',
    href: '/conversations/blue-azores',
  },
];

const supplementary = [
  { type: 'Playlist', title: 'Opa Collective on The Colour Blue', pages: '10–11', href: '/playlists/sound-of-blue' },
  { type: 'Picture Essay', title: 'The Blues of Antonio Dacosta', contributors: 'Urbano Resendes', pages: '28–49', image: imgDacostaEssay, alt: 'Dacosta, Memory V, 1982, acrylic, collage, wax crayon' },
  { type: 'Playlist', title: 'Azorean Blues', pages: '77–79', href: '/playlists/azorean-blues' },
  { type: 'Map', title: 'Ruins of the Azores', contributors: 'Ilheu Atelier', pages: '92–93' },
  { type: 'Comic Strip', title: 'Out of Control in Ponta Delgada', contributors: 'Sara Azad', pages: '112', image: imgComic, alt: 'Comic strip by Sara Azad, Out of Control in Ponta Delgada' },
  { type: 'Prose', title: 'Swimming Pools: Black and Blue — A Short Story of Unravelling in Water', contributors: 'Kathleen McCaul', pages: '114–121' },
];
---

<BaseLayout
  title="Issue B: The Colour Blue — Ilhéu Magazine"
  description="Issue B of Ilhéu Magazine — 'The Colour Blue'. Conversations, prose, photography and design from the Azores."
>

  <!-- ═══════════════════════════════════════════
       HERO
       ═══════════════════════════════════════════ -->
  <section class="min-h-screen flex items-center bg-white">
    <div class="max-w-6xl mx-auto px-6 py-24 lg:py-32 w-full">
      <div class="lg:grid lg:grid-cols-12 lg:gap-20 lg:items-center">

        <!-- Text -->
        <div class="lg:col-span-5 mb-16 lg:mb-0 text-center lg:text-left">
          <p class="font-inter text-xs uppercase tracking-[0.3em] text-gray-400 mb-8">
            Issue B &middot; Spring 2026
          </p>
          <h1
            class="font-minion italic text-6xl sm:text-7xl lg:text-8xl leading-[1.0] mb-5"
            style={`color: ${accentColour}`}
          >
            The Colour Blue
          </h1>
          <p class="font-inter text-sm text-gray-500 leading-relaxed max-w-sm mx-auto lg:mx-0 mb-10">
            Conversations, prose, photography and design, produced and published on the Azorean island of Sao Miguel. 128 pages on the colour blue.
          </p>
          <a
            href={purchaseUrl}
            class="inline-block text-white font-inter text-xs uppercase tracking-[0.2em] px-12 py-4 hover:opacity-90 transition-opacity duration-300"
            style={`background-color: ${accentColour}`}
          >
            Buy This Issue
          </a>
        </div>

        <!-- Cover -->
        <div class="lg:col-span-7 flex justify-center lg:justify-end">
          <div class="relative max-w-sm lg:max-w-md">
            <Image
              src={coverImage}
              alt="Cover of Ilhéu Magazine Issue B: The Colour Blue"
              class="w-full shadow-2xl"
              widths={[400, 600, 800]}
              sizes="(max-width: 640px) 360px, (max-width: 1024px) 400px, 480px"
            />
            <div
              class="absolute -bottom-6 left-[10%] right-[10%] h-12 blur-2xl opacity-15 rounded-full -z-10"
              style={`background-color: ${accentColour}`}
            />
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       PURE BLUE ILHÉU — title slate
       Magazine title-page moment after the cover.
       ═══════════════════════════════════════════ -->
  <section class="bg-white py-20 sm:py-28 lg:py-36 border-y border-gray-100">
    <div class="max-w-4xl mx-auto px-6 flex flex-col items-center text-center">
      <img
        src="/images/ilheu-logo-pure-blue.png"
        alt="Ilhéu — Pure Blue"
        class="w-full max-w-xl sm:max-w-2xl lg:max-w-3xl mb-8 sm:mb-10"
      />
      <p class="font-inter text-[11px] sm:text-xs uppercase tracking-[0.35em] text-gray-400">
        Issue B &middot; Spring 2026
      </p>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       EDITORIAL LETTER
       ═══════════════════════════════════════════ -->
  <section class="text-white" style={`background-color: ${accentColour}`}>
    <div class="max-w-3xl mx-auto px-6 py-24 lg:py-32">

      <p class="font-inter text-[11px] font-bold uppercase tracking-[0.25em] text-white/50 mb-12">
        Editor&rsquo;s Letter
      </p>

      <div class="relative">
        <div id="editorial-content" class="font-minion text-lg sm:text-xl leading-[1.9] text-white/90 space-y-8 max-h-[28rem] overflow-hidden transition-[max-height] duration-700 ease-in-out">

        <!-- Epigraph -->
        <blockquote class="border-l-2 border-white/20 pl-6 italic text-white/70 text-base sm:text-lg leading-[1.9]">
          <p>And so I fell in love with a colour &mdash; in this case, the colour blue &mdash; as if falling under a spell, a spell I fought to stay under and get out from under, in turns.</p>
          <footer class="mt-3 not-italic text-sm text-white/50">&mdash; Maggie Nelson, <em>Bluets</em></footer>
        </blockquote>

        <p>Welcome to the second issue of Ilh&eacute;u &mdash; a magazine of conversations, prose, photography and design, produced and published on the Azorean island of S&atilde;o Miguel. The people who make this magazine run on the sun, the wind and the rain of the Atlantic, and we do this work for everyone who loves beautiful stories, images and words.</p>

        <p>The theme of this second issue is the colour blue, inspired &mdash; of course &mdash; by the inescapable ocean which shapes the days and the minds of all who live in the Azores. As soon as we declared Ilh&eacute;u&rsquo;s search for Pure Blue, I realised that blue was in fact the least pure of all the colours. The sun is almost always yellow, the moon almost always white, but the view of the sea and the sky from my bedroom window is in constant flux. The hues change moment by moment: muddying, lightening, streaked with pinks and greens and golds, mutable, moody, shimmeringly fickle. And then there are all the different meanings of blue, perhaps the only colour which contains so much emotion, so much history, so much art.</p>

        <p>It was the English who began to use &lsquo;blue&rsquo; to mean depressed or melancholy in the late 17th century. Having the &lsquo;blue devils&rsquo; meant a person had been overwhelmed with bad spirits &mdash; bedevilled by their own feelings. By the 1800s, the term was adopted by slaves in the American South to mean sorrow, trouble, a burdened heart. This expression merged with negro spirituals and field-work songs to create the form of music we now call &lsquo;the blues&rsquo;, a style which, until today, represents suffering, endurance, struggle and strife. In the words of the great bluesman Robert Johnson: &lsquo;The blues is a low-down achin&rsquo; heart disease&rsquo;. And there is another, seedier side to the colour: for centuries, blue jokes and blue stories meant something sexual or out-of-bounds. In the 20th century this developed into the notion of blue movies as pornographic or risqu&eacute;. And in this way the history of blue gives us a colour and much more than that. It is a word which straddles and symbolises our unacceptable desires, as well as all our soul endures.</p>

        <p>This issue on Pure Blue is made up of images, conversations, maps, prose fiction and a comic strip. Sandra Rocha and Marco Costa&rsquo;s photographs, featured between the stories, illuminate blue through two different Azorean lenses. The bright saturated waves of Costa&rsquo;s book Atl&acirc;ntico 744 celebrate the often thankless, sometimes ecstatic but always blue business of being a surfer in S&atilde;o Miguel. The washed-out sea around Rocha&rsquo;s misty Terceira is the mild blue of homesickness, taken from her book Anticyclone, portraits of family life upon a damp, Atlantic island, taken on trips back home. Then we have our five conversations which all investigate blue in their own particular ways &mdash; although none of them are, admittedly, very pure at all. Sometimes the connection to blue was obvious &mdash; for example, in the story of the new Azorean marine park &lsquo;Blue Azores&rsquo;. Other stories were more questionable in their relation to blue. Is a grand architectural masterpiece of a swimming pool, abandoned before being opened in the remotest corner of the island, really something blue? The scrubby, dirty tiles are a pale turquoise, it is true. But perhaps it is the flagrant way in which the six-million-euro pool was left to ruin that is the most risqu&eacute;, the most blue thing about this story. What about the starry Le&iuml;la Slimani and her conversation with local writer Maria Brand&atilde;o? They both write about sex in graphic, violent ways. Is it enough to call this &lsquo;blue&rsquo; writing or is there something more to their conversation? Writer&rsquo;s block, it turns out, is the ultimate blues for these women. The viola da terra-player Romeu Bairos makes modern Azorean folk music &mdash; is this the blues? Film director Diogo Lima was suspicious of linking the history of African American music with local songs, but Romeu&rsquo;s tales of gangsters&rsquo; heartbreak and woe upon this remote, isolated island won him over. Then there is our lead story, about the great Azorean painter Ant&oacute;nio Dacosta, who moved to Paris and then stopped painting for thirty years, returning in great glory only at the age of 69. Is it correct to say he had the blues for three decades? Or perhaps those long years of little work, in which one of the few paintings he produced was a single blue canvas, could be called his blue period? It was with these kinds of questions that we slowly, haltingly, discovered the varied shades and meanings of blue, as well as the qualities that these very different conversations shared &mdash; values that united the people featured here and, in the end, looped back to those first early meanings of the blues.</p>

        <p>Despite our breezy, summery cover, the conversations here all contain that &lsquo;achin&rsquo; heart disease&rsquo; &mdash; from Le&iuml;la Slimani describing how she goes to bed for days when she can&rsquo;t write, to Bernardo Brito e Abreu and Adriano Quintela describing how difficult it is to feel positive in the face of the ongoing rampant destruction of the ocean they are trying to rescue; or Arlete Alves da Silva remembering the little drawing of a skull, a thread and a pair of scissors, drawn for her by Dacosta when he knew he was dying, so shortly after he had returned with such assurance, with such depth, to painting. However, linking all the different types of pain expressed by the people we talk to in this issue is a sense of survival and a belief that there is value in the dark parts of our stories. And I think it is this particular combination of celebrating heartbreak whilst passing through it, holding on to the filigree of hope which lightens the black to something with blue dawn glimmers, that makes the idea of the blues so valuable and enduring. Ralph Ellison, a blues writer if ever there was one, puts it very well: &lsquo;The blues is an impulse to keep the painful details and episodes of a brutal experience alive in one&rsquo;s aching consciousness, to finger its jagged grain, and to transcend it, not by the consolation of philosophy but by squeezing from it a near-tragic, near-comic lyricism.&rsquo;</p>

        <p class="text-white/60 text-base mt-12">Kathleen McCaul, February 2026</p>

        <p class="text-white/40 text-sm mt-6 italic">1. Ralph Ellison, <em>Shadow and Act</em> (New York: Random House, 1964)</p>

        </div>

        <div
          id="editorial-fade"
          class="absolute bottom-0 inset-x-0 h-40 pointer-events-none transition-opacity duration-500"
          style={`background: linear-gradient(to top, ${accentColour}, transparent)`}
        ></div>
      </div>

      <div class="text-center mt-10">
        <button
          id="editorial-toggle"
          type="button"
          class="font-inter text-[11px] uppercase tracking-[0.2em] text-white/40 hover:text-white/70 transition-colors duration-300 cursor-pointer"
        >
          Continue reading
        </button>
      </div>

    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       CONVERSATIONS — INTRO
       ═══════════════════════════════════════════ -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 pt-32 sm:pt-40 lg:pt-48 pb-20 sm:pb-28 lg:pb-32">
      <p class="font-inter text-xs uppercase tracking-[0.3em] text-gray-400 mb-8 lg:mb-10">
        Inside This Issue
      </p>

      <h2 class="font-minion text-5xl sm:text-7xl lg:text-8xl leading-[1.0] text-gray-900 mb-10 lg:mb-14 max-w-4xl">
        Five Conversations <em class="text-gray-400 font-normal">on Blue</em>
      </h2>

      <div class="grid lg:grid-cols-12 gap-10 lg:gap-12">
        <p class="font-minion text-xl sm:text-2xl lg:text-3xl italic leading-[1.4] text-gray-700 lg:col-span-7 max-w-3xl">
          Five investigations into the least pure of all the colours &mdash; from the Paris blues of the painter Ant&oacute;nio Dacosta to the architectural ruin of a six-million-euro swimming pool, from Le&iuml;la Slimani on writer&rsquo;s block to Romeu Bairos on the viola da terra, all the way down to the underwater stillness of the Azorean marine park.
        </p>
        <div class="lg:col-span-4 lg:col-start-9 lg:pt-2">
          <p class="font-inter text-[10px] uppercase tracking-[0.3em] text-gray-400 mb-5">
            In this section
          </p>
          <ul class="font-inter text-[11px] uppercase tracking-[0.25em] text-gray-700 space-y-3 leading-relaxed">
            <li>01 &nbsp;&middot;&nbsp; Art &nbsp;&mdash;&nbsp; Dacosta</li>
            <li>02 &nbsp;&middot;&nbsp; Writing &nbsp;&mdash;&nbsp; Slimani</li>
            <li>03 &nbsp;&middot;&nbsp; Music &nbsp;&mdash;&nbsp; Bairos</li>
            <li>04 &nbsp;&middot;&nbsp; Architecture &nbsp;&mdash;&nbsp; The Pool</li>
            <li>05 &nbsp;&middot;&nbsp; Environment &nbsp;&mdash;&nbsp; Blue Azores</li>
          </ul>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       FIVE FULL-BLEED CINEMATIC CONVERSATIONS
       Title overlays image with mix-blend-difference —
       text colour inverts against the photograph behind it.
       ═══════════════════════════════════════════ -->
  {conversations.map((item, idx) => {
    const num = String(idx + 1).padStart(2, '0');
    return (
      <a
        href={item.href}
        class="block group relative bg-gray-900 focus-visible:outline-4 focus-visible:-outline-offset-8 focus-visible:outline-white outline-none"
      >
        <div class="relative h-[85vh] sm:h-[90vh] lg:h-screen overflow-hidden">
          {/* Full-brightness photograph / video background */}
          {item.videoSrc ? (
            <video
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              poster={item.image.src}
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1800ms] ease-out motion-safe:group-hover:scale-[1.05]"
            >
              <source src={item.videoSrc} type="video/mp4" />
            </video>
          ) : (
            <Image
              src={item.image}
              alt={item.alt}
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1800ms] ease-out motion-safe:group-hover:scale-[1.05]"
              widths={[800, 1200, 1800, 2400]}
              sizes="100vw"
            />
          )}

          {/* Top + bottom gradient — same as Picture Essay */}
          <div
            class="absolute inset-0 pointer-events-none"
            style="background: linear-gradient(to bottom, rgba(0,0,0,0.5) 0%, transparent 22%, transparent 60%, rgba(0,0,0,0.6) 100%);"
          ></div>

          {/* Top — eyebrow + page numbers */}
          <div class="absolute top-0 inset-x-0 p-6 sm:p-10 lg:p-14">
            <div class="max-w-6xl mx-auto flex items-baseline justify-between gap-4">
              <p class="font-inter text-[10px] sm:text-[11px] font-bold uppercase tracking-[0.3em] text-white">
                {item.category} &middot; Conversation {num}
              </p>
              <p class="font-inter text-[10px] sm:text-[11px] uppercase tracking-[0.3em] text-white/80">
                pp. {item.pages}
              </p>
            </div>
          </div>

          {/* Bottom — title (mix-blend-difference, fades in/out at viewport centre) */}
          <div class="absolute bottom-0 inset-x-0 p-6 sm:p-10 lg:p-14 scroll-fade-center">
            <div class="max-w-6xl mx-auto">
              {/* Cream + text-shadow for Dacosta and Pool (low-contrast photos);
                  mix-blend-difference for the rest (their photos read fine). */}
              {(item.href === '/conversations/dacosta' || item.href === '/conversations/pool') ? (
                <h3
                  class="font-minion italic text-5xl sm:text-7xl lg:text-[9rem] leading-[0.95] mb-6 sm:mb-8 max-w-5xl"
                  style="color: #F6F1E8; text-shadow: 0 1px 3px rgba(0,0,0,0.4), 0 6px 28px rgba(0,0,0,0.55);"
                >
                  {item.title}
                </h3>
              ) : (
                <h3 class="font-minion italic text-5xl sm:text-7xl lg:text-[9rem] leading-[0.95] text-white mb-6 sm:mb-8 max-w-5xl mix-blend-difference">
                  {item.title}
                </h3>
              )}
              <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3 max-w-5xl">
                <p class="font-minion text-base sm:text-lg italic text-white/85">
                  With {item.contributors}
                </p>
                <span class="font-inter text-[11px] uppercase tracking-[0.25em] text-white inline-flex items-center gap-2 motion-safe:transition-all motion-safe:duration-[600ms]">
                  Read the conversation
                  <span class="inline-block motion-safe:transition-transform motion-safe:duration-[600ms] motion-safe:group-hover:translate-x-2">&rarr;</span>
                </span>
              </div>
            </div>
          </div>
        </div>
      </a>
    );
  })}


  <!-- ═══════════════════════════════════════════
       ALSO IN THIS ISSUE — INTRO
       ═══════════════════════════════════════════ -->
  <section class="bg-white border-t border-gray-100">
    <div class="max-w-6xl mx-auto px-6 pt-32 sm:pt-40 lg:pt-48 pb-20 sm:pb-28 lg:pb-32">
      <p class="font-inter text-xs uppercase tracking-[0.3em] text-gray-400 mb-8 lg:mb-10">
        Also in this issue
      </p>

      <h2 class="font-minion text-5xl sm:text-7xl lg:text-8xl leading-[1.0] text-gray-900 mb-10 lg:mb-14 max-w-4xl">
        Maps, playlists <em class="text-gray-400 font-normal">&amp; interludes</em>
      </h2>

      <div class="grid lg:grid-cols-12 gap-10 lg:gap-12">
        <p class="font-minion text-xl sm:text-2xl lg:text-3xl italic leading-[1.4] text-gray-700 lg:col-span-7 max-w-3xl">
          Threading between the conversations: a picture essay on Dacosta&rsquo;s late period, two playlists curated to set the issue&rsquo;s mood, a hand-drawn map of Azorean ruins, a comic strip from Ponta Delgada, and a short story by Kathleen McCaul. Interludes that hold the page between the louder voices.
        </p>
        <div class="lg:col-span-4 lg:col-start-9 lg:pt-2">
          <p class="font-inter text-[10px] uppercase tracking-[0.3em] text-gray-400 mb-5">
            In this section
          </p>
          <ul class="font-inter text-[11px] uppercase tracking-[0.25em] text-gray-700 space-y-3 leading-relaxed">
            <li>Picture Essay &nbsp;&mdash;&nbsp; Dacosta</li>
            <li>Playlist 01 &nbsp;&mdash;&nbsp; Opa Collective</li>
            <li>Map &nbsp;&mdash;&nbsp; Ruins of the Azores</li>
            <li>Playlist 02 &nbsp;&mdash;&nbsp; Azorean Blues</li>
            <li>Comic Strip &nbsp;&mdash;&nbsp; Sara Azad</li>
            <li>Prose &nbsp;&mdash;&nbsp; Kathleen McCaul</li>
          </ul>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       PICTURE ESSAY — full-bleed, mix-blend title
       ═══════════════════════════════════════════ -->
  <section class="relative bg-gray-900 group">
    <div class="relative h-[75vh] sm:h-[85vh] lg:h-screen overflow-hidden">
      <Image
        src={supplementary[1].image!}
        alt={supplementary[1].alt!}
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1800ms] ease-out motion-safe:group-hover:scale-[1.05]"
        widths={[1200, 1800, 2400]}
        sizes="100vw"
      />
      <div
        class="absolute inset-0 pointer-events-none"
        style="background: linear-gradient(to bottom, rgba(0,0,0,0.5) 0%, transparent 22%, transparent 60%, rgba(0,0,0,0.6) 100%);"
      ></div>

      <div class="absolute top-0 inset-x-0 p-6 sm:p-10 lg:p-14">
        <div class="max-w-6xl mx-auto">
          <p class="font-inter text-[10px] sm:text-[11px] font-bold uppercase tracking-[0.3em] text-white">
            Picture Essay &middot; pp. {supplementary[1].pages}
          </p>
        </div>
      </div>

      <div class="absolute bottom-0 inset-x-0 p-6 sm:p-10 lg:p-14">
        <div class="max-w-6xl mx-auto">
          <h3 class="font-minion italic text-5xl sm:text-7xl lg:text-[9rem] leading-[0.95] text-white mb-6 sm:mb-8 max-w-5xl mix-blend-difference">
            {supplementary[1].title}
          </h3>
          <p class="font-minion text-base sm:text-lg italic text-white/85">
            By {supplementary[1].contributors}
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       PLAYLISTS — paired record sleeves
       Each tile is a photograph (album-cover style)
       with a vinyl record overlay (grooves + label)
       and mix-blend-difference title.
       ═══════════════════════════════════════════ -->
  <section class="grid sm:grid-cols-2">

