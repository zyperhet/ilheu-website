---
import { getCollection, getEntries, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleTeaser from '../../components/ArticleTeaser.astro';
import ContributorCard from '../../components/ContributorCard.astro';

export async function getStaticPaths() {
  const editions = await getCollection('editions');
  return editions.map((edition) => ({
    params: { editionId: edition.id },
    props: { edition },
  }));
}

const { edition } = Astro.props;

// Filter articles belonging to this edition (trailing slash prevents prefix collision)
const articles = await getCollection(
  'articles',
  ({ id }) => id.startsWith(edition.id + '/')
);

// Sort articles by published_date ascending (editorial order)
const sortedArticles = articles.sort(
  (a, b) => a.data.published_date.getTime() - b.data.published_date.getTime()
);

// Resolve each article's author
const articlesWithAuthors = await Promise.all(
  sortedArticles.map(async (article) => {
    const author = await getEntry(article.data.author);
    return { article, authorName: author?.data.name ?? 'Unknown' };
  })
);

// Resolve contributor references
const contributors = edition.data.contributors
  ? await getEntries(edition.data.contributors)
  : [];

const pageTitle = `${edition.data.title} — ${edition.data.theme} — Ilhéu Magazine`;
const pageDescription = `Edition ${edition.data.edition_number} of Ilhéu Magazine: "${edition.data.theme}"`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="max-w-4xl mx-auto px-4 py-12 md:py-20">

    <!-- Theme hero: text leading, cover supporting -->
    <header class="mb-10 md:mb-16">
      <div class="flex flex-col md:flex-row md:items-start md:gap-12">
        <!-- Theme text (leads on desktop) -->
        <div class="flex-1 mb-8 md:mb-0">
          <p class="text-xs text-gray-400 uppercase tracking-widest mb-3">
            Edition {edition.data.edition_number}
          </p>
          <h1 class="font-cardo text-4xl md:text-5xl lg:text-6xl leading-tight mb-3">
            {edition.data.theme}
          </h1>
          <p class="text-xl text-gray-500 mb-6">{edition.data.title}</p>

          <!-- Buy CTA: prominent near top, hidden if no purchase_url -->
          {edition.data.purchase_url && (
            <a
              href={edition.data.purchase_url}
              class="inline-block px-6 py-3 bg-black text-white text-sm uppercase tracking-wider hover:bg-gray-800 transition-colors duration-200"
            >
              Buy this edition
            </a>
          )}
        </div>

        <!-- Cover image (supporting, mobile: below text) -->
        {edition.data.cover_image && (
          <div class="md:w-56 lg:w-64 shrink-0">
            <Image
              src={edition.data.cover_image}
              alt={`Cover of ${edition.data.title}`}
              class="w-full shadow-md"
              widths={[256, 512]}
              sizes="(max-width: 768px) 100vw, 256px"
            />
          </div>
        )}
      </div>
    </header>

    <!-- Edition description (rendered from markdown body) -->
    {articles.length > 0 && (
      <section class="mb-12 md:mb-16">
        <h2 class="font-cardo text-2xl mb-6 pb-3 border-b border-gray-200">
          In this edition
        </h2>
        <div class="divide-y divide-gray-100">
          {articlesWithAuthors.map(({ article, authorName }) => (
            <ArticleTeaser article={article} authorName={authorName} />
          ))}
        </div>
      </section>
    )}

    <!-- Contributors -->
    {contributors.length > 0 && (
      <section class="mb-12">
        <h2 class="font-cardo text-2xl mb-6 pb-3 border-b border-gray-200">
          Contributors
        </h2>
        <div class="flex flex-wrap gap-6">
          {contributors.map((contributor) => (
            <ContributorCard contributor={contributor} />
          ))}
        </div>
      </section>
    )}

    <!-- Back to editions -->
    <nav class="pt-8 border-t border-gray-100">
      <a
        href="/editions"
        class="text-sm text-gray-500 hover:text-gray-900 transition-colors"
      >
        &larr; All editions
      </a>
    </nav>

  </div>
</BaseLayout>
