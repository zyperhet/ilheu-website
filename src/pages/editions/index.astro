---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditionCard from '../../components/EditionCard.astro';

const allEditions = await getCollection('editions');

// Sort by edition_number descending (newest first)
const editions = allEditions.sort(
  (a, b) => b.data.edition_number - a.data.edition_number
);
---

<BaseLayout title="Editions — Ilhéu Magazine" description="Browse all editions of Ilhéu Magazine, a biannual literary and cultural publication from the Azores.">
  <div class="max-w-5xl mx-auto px-4 py-12 md:py-20">
    <header class="mb-12 md:mb-16">
      <h1 class="font-cardo text-4xl md:text-5xl mb-3">Editions</h1>
      <p class="text-gray-500 text-lg">
        {editions.length === 1
          ? '1 edition published'
          : `${editions.length} editions published`}
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10">
      {editions.map((edition) => (
        <EditionCard edition={edition} />
      ))}
    </div>
  </div>
</BaseLayout>
