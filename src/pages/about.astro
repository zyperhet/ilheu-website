---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — Ilhéu Magazine" description="Credits and colophon for Ilhéu Magazine, Issue B, Spring 2026." navVariant="dark" fullBleed>
  <section class="bg-[#3B3F9E] text-white pt-28 md:pt-40 pb-20 md:pb-28 px-6">
    <div class="max-w-6xl mx-auto">

      <!-- Wordmark -->
      <h1 class="font-cardo text-5xl md:text-7xl lg:text-8xl font-bold text-center mb-20 md:mb-28 tracking-wide">ILHÉU</h1>

      <!-- Three-column grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-14 md:gap-10 lg:gap-14">

        <!-- Column 1: People -->
        <div class="space-y-10">

          <div>
            <h2 class="font-inter text-xs uppercase tracking-[0.2em] text-white/50 mb-3">Editor</h2>
            <p class="font-body text-sm text-white/90 leading-relaxed">Kathleen McCaul</p>
          </div>

          <div>
            <h2 class="font-inter text-xs uppercase tracking-[0.2em] text-white/50 mb-3">Graphic Design</h2>
            <p class="font-body text-sm text-white/90 leading-relaxed">Júlia Garcia</p>
            <p class="font-body text-sm text-white/50 leading-relaxed">Assisted by Caetano Kühne</p>
          </div>

          <div>
            <h2 class="font-inter text-xs uppercase tracking-[0.2em] text-white/50 mb-3">Editorial Team</h2>
            <p class="font-body text-sm text-white/90 leading-relaxed">Andrea Santolaya, Filipe Moura, Kathleen McCaul, Júlia Garcia</p>
          </div>

          <div>
            <h2 class="font-inter text-xs uppercase tracking-[0.2em] text-white/50 mb-3">Contributors</h2>
            <p class="font-body text-sm text-white/90 leading-relaxed">Ilhéu Atelier: Afonso Botelho Santos and Rita Sampaio, Arlete Alves da Silva, Rui Brito and Galeria 111, Sara Azad, José António Barbosa, Romeu Bairos, Maria Brandão, Bernardo Brito e Abreu, Diogo Lima, Oscar Opoku-Banful Taylor, Adriano Quintela, Urbano Resendes, Leïla Slimani</p>
          </div>

          <div>
            <h2 class="font-inter text-xs uppercase tracking-[0.2em] text-white/50 mb-3">Photographers</h2>
            <p class="font-body text-sm text-white/90 leading-relaxed">Maria Abranches, Marina Cruz, Marco Costa, Pedro Duarte Jorge, Paulo Goulart, Nelson Raposo, Sandra Rocha, Andrea Santolaya</p>
          </div>

        </div>

        <!-- Column 2: Production -->
        <div class="space-y-10">

          <div>
            <p class="font-body text-sm text-white/90 leading-relaxed">The between-story photos are taken from the books <em>Atlântico 744</em>, by Marco Costa and <em>Azores Atlantic Surfers</em>, and <em>Anticyclone</em> by Sandra Rocha.</p>
          </div>

          <div>
            <h2 class="font-inter text-xs uppercase tracking-[0.2em] text-white/50 mb-3">English Proof Reading</h2>
            <p class="font-body text-sm text-white/90 leading-relaxed">Jonathan Weil</p>
          </div>

          <div>
            <h2 class="font-inter text-xs uppercase tracking-[0.2em] text-white/50 mb-3">Portuguese Proof Reading</h2>
            <p class="font-body text-sm text-white/90 leading-relaxed">Pedro Arruda, Maria Brandão, Diogo Lima, Urbano Resendes</p>
          </div>

          <div>
            <h2 class="font-inter text-xs uppercase tracking-[0.2em] text-white/50 mb-3">Typography</h2>
            <p class="font-body text-sm text-white/90 leading-relaxed">PT Serif, Saira, Saira Condensed, Anton</p>
          </div>

          <div>
            <h2 class="font-inter text-xs uppercase tracking-[0.2em] text-white/50 mb-3">Paper</h2>
            <p class="font-body text-sm text-white/90 leading-relaxed">Munken Pure 100g</p>
          </div>

          <div>
            <h2 class="font-inter text-xs uppercase tracking-[0.2em] text-white/50 mb-3">Print and Finishing</h2>
            <p class="font-body text-sm text-white/90 leading-relaxed">Nova Gráfica</p>
          </div>

          <div>
            <h2 class="font-inter text-xs uppercase tracking-[0.2em] text-white/50 mb-3">Copies</h2>
            <p class="font-body text-sm text-white/90 leading-relaxed">1,850</p>
          </div>

          <div>
            <h2 class="font-inter text-xs uppercase tracking-[0.2em] text-white/50 mb-3">ISBN</h2>
            <p class="font-body text-sm text-white/90 leading-relaxed">978-989-33-6588-5</p>
          </div>

          <div>
            <h2 class="font-inter text-xs uppercase tracking-[0.2em] text-white/50 mb-3">With Special Thanks to</h2>
            <p class="font-body text-sm text-white/90 leading-relaxed">Dirk Mönkemöller, Jesse James, António Castro Freire, Catarina Ferreira, Arlete Alves da Silva, Urbano Resendes</p>
          </div>

        </div>

        <!-- Column 3: Publication Info -->
        <div class="space-y-10">

          <div>
            <p class="font-body text-sm text-white/90 leading-relaxed font-medium">Ilhéu Magazine, Issue B, Spring 2026, &euro;15</p>
          </div>

          <div>
            <p class="font-body text-sm text-white/90 leading-relaxed">Ilhéu magazine is published and printed at Nova Gráfica, São Miguel, Azores, Rua de Encarnação, 21 Fajã de Baixo, 9500-513, Ponta Delgada</p>
          </div>

          <div>
            <h2 class="font-inter text-xs uppercase tracking-[0.2em] text-white/50 mb-3">Contact</h2>
            <div class="space-y-1">
              <p class="font-body text-sm text-white/90 leading-relaxed">
                <a href="mailto:contact@ilheumagazine.com" class="underline underline-offset-2 decoration-white/30 hover:decoration-white transition-colors">contact@ilheumagazine.com</a>
              </p>
              <p class="font-body text-sm text-white/90 leading-relaxed">
                <a href="https://ilheumagazine.com" class="underline underline-offset-2 decoration-white/30 hover:decoration-white transition-colors">ilheumagazine.com</a>
              </p>
              <p class="font-body text-sm text-white/90 leading-relaxed">
                <a href="https://www.instagram.com/ilheumagazine" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 decoration-white/30 hover:decoration-white transition-colors">@ilheumagazine</a>
              </p>
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>
</BaseLayout>
