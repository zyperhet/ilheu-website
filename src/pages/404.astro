---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

import lostImage from '../assets/images/404-lost.jpg';
---

<BaseLayout title="Lost at Sea — Ilhéu Magazine">
  <section class="relative h-[85vh] flex items-center justify-center overflow-hidden">
    <!-- Background image -->
    <Image
      src={lostImage}
      alt="A woman reaching across dark volcanic rocks under an overcast sky"
      class="absolute inset-0 w-full h-full object-cover"
      widths={[800, 1200, 1800, 2400]}
      sizes="100vw"
      quality={85}
    />

    <!-- Dark gradient overlay for text readability -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-black/10"></div>

    <!-- Content -->
    <div class="relative z-10 text-center px-6">
      <h1 class="font-cardo text-5xl sm:text-6xl lg:text-7xl text-white mb-4 leading-tight">
        Lost at sea
      </h1>
      <p class="font-inter text-sm sm:text-base text-white/70 max-w-md mx-auto mb-10 leading-relaxed">
        The page you're looking for doesn't exist.
      </p>
      <a
        href="/"
        class="inline-block font-inter text-xs uppercase tracking-[0.2em] text-white border border-white/60 px-8 py-4 hover:bg-white hover:text-gray-900 transition-all duration-300"
      >
        Return Home
      </a>
    </div>
  </section>
</BaseLayout>
