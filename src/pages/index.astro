  <!-- ═══════════════════════════════════════════
       PROSE — full-bleed cream typographic
       Giant italic quote glyphs as watermarks.
       ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden" style="background-color: #F6F1E8;">
    <div class="h-[75vh] sm:h-[85vh] lg:h-screen relative">

      {/* Opening quote glyph — top-left, off-frame */}
      <span
        aria-hidden="true"
        class="absolute -top-32 sm:-top-44 lg:-top-56 -left-6 sm:-left-12 lg:-left-16 font-minion italic text-[28rem] sm:text-[44rem] lg:text-[60rem] leading-none select-none pointer-events-none"
        style={`color: ${accentColour}; opacity: 0.09;`}
