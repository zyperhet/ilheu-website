---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

const allEditions = await getCollection('editions');
const currentEdition = allEditions.find(e => e.data.status === 'current');
const archivedEditions = allEditions
  .filter(e => e.data.status === 'archive')
  .sort((a, b) => b.data.edition_number - a.data.edition_number);

let featuredArticle = null;
let featuredAuthor = null;
if (currentEdition) {
  const featured = await getCollection('articles', ({ id, data }) =>
    id.startsWith(currentEdition.id + '/') && data.featured === true
  );
  featuredArticle = featured[0] || null;
  if (featuredArticle) {
    featuredAuthor = await getEntry(featuredArticle.data.author);
  }
}
---

<BaseLayout
  title="Ilhéu Magazine"
  description="Ilhéu is a biannual literary and cultural magazine from the Azores."
>
  {currentEdition && (
    <!-- Current Edition Hero -->
    <section class="border-b border-gray-200">
      <div class="max-w-6xl mx-auto px-6 py-16 lg:py-24">
        <div class="lg:grid lg:grid-cols-2 lg:gap-16 lg:items-center">
          <!-- Text block -->
          <div class="mb-10 lg:mb-0">
            <p class="text-sm uppercase tracking-widest text-gray-500 mb-4 font-inter">
              Edition {currentEdition.data.edition_number}
            </p>
            <a href={`/editions/${currentEdition.id}`} class="block group">
              <h1
                class="font-cardo text-5xl lg:text-7xl leading-tight text-gray-900 mb-4 group-hover:text-gray-600 transition-colors"
                style={currentEdition.data.accent_colour ? `color: ${currentEdition.data.accent_colour}` : ''}
              >
                {currentEdition.data.theme}
              </h1>
              <p class="font-cardo text-2xl text-gray-500 mb-8">
                {currentEdition.data.title}
              </p>
            </a>
            {currentEdition.data.purchase_url && (
              <a
                href={currentEdition.data.purchase_url}
                class="inline-block bg-gray-900 text-white font-inter text-sm uppercase tracking-widest px-8 py-4 hover:bg-gray-700 transition-colors"
              >
                Buy Edition
              </a>
            )}
          </div>
          <!-- Cover image -->
          <div class="order-first lg:order-last">
            {currentEdition.data.cover_image ? (
              <Image
                src={currentEdition.data.cover_image}
                alt={`Cover of Ilhéu Magazine Edition ${currentEdition.data.edition_number}: ${currentEdition.data.title}`}
                class="w-full max-w-md mx-auto lg:max-w-full shadow-lg"
              />
            ) : (
              <div
                class="w-full aspect-[3/4] max-w-md mx-auto lg:max-w-full flex items-center justify-center"
                style={currentEdition.data.accent_colour ? `background-color: ${currentEdition.data.accent_colour}` : 'background-color: #1a1a1a'}
              >
                <span class="font-cardo text-white text-3xl lg:text-4xl text-center px-8 leading-snug">
                  {currentEdition.data.theme}
                </span>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  {featuredArticle && featuredAuthor && (
    <!-- Featured Article Highlight -->
    <section class="border-b border-gray-200 bg-gray-50">
      <div class="max-w-3xl mx-auto px-6 py-16 lg:py-20">
        <p class="text-xs uppercase tracking-widest text-gray-400 mb-8 font-inter">
          From This Edition
        </p>
        <a href={`/articles/${featuredArticle.id}`} class="block group mb-6">
          <h2 class="font-cardo text-3xl lg:text-4xl text-gray-900 mb-5 group-hover:text-gray-600 transition-colors leading-snug">
            {featuredArticle.data.title}
          </h2>
          <p class="font-inter text-gray-600 text-base lg:text-lg leading-relaxed">
            {featuredArticle.data.excerpt}
          </p>
        </a>
        <p class="font-inter text-sm text-gray-500">
          By{' '}
          <a
            href={`/contributors/${featuredAuthor.id}`}
            class="text-gray-900 underline underline-offset-2 hover:text-gray-600 transition-colors"
          >
            {featuredAuthor.data.name}
          </a>
        </p>
      </div>
    </section>
  )}

  {archivedEditions.length > 0 && (
    <!-- Edition Archive Preview -->
    <section>
      <div class="max-w-6xl mx-auto px-6 py-16 lg:py-20">
        <div class="flex items-baseline justify-between mb-10">
          <h2 class="font-cardo text-2xl lg:text-3xl text-gray-900">
            Past Editions
          </h2>
          <a
            href="/editions"
            class="font-inter text-sm text-gray-500 underline underline-offset-2 hover:text-gray-900 transition-colors"
          >
            View all editions
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {archivedEditions.map((edition) => (
            <a href={`/editions/${edition.id}`} class="group block">
              {edition.data.cover_image ? (
                <Image
                  src={edition.data.cover_image}
                  alt={`Cover of Ilhéu Magazine Edition ${edition.data.edition_number}: ${edition.data.title}`}
                  class="w-full aspect-[3/4] object-cover mb-4 shadow-sm group-hover:shadow-md transition-shadow"
                />
              ) : (
                <div
                  class="w-full aspect-[3/4] mb-4 flex items-center justify-center"
                  style={edition.data.accent_colour ? `background-color: ${edition.data.accent_colour}` : 'background-color: #333'}
                >
                  <span class="font-cardo text-white text-xl text-center px-4 leading-snug">
                    {edition.data.theme}
                  </span>
                </div>
              )}
              <p class="font-inter text-xs uppercase tracking-widest text-gray-400 mb-1">
                Edition {edition.data.edition_number}
              </p>
              <h3 class="font-cardo text-xl text-gray-900 group-hover:text-gray-600 transition-colors mb-1">
                {edition.data.title}
              </h3>
              <p class="font-inter text-sm text-gray-500">
                {edition.data.theme}
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
