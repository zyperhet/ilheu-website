---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ConcertBanner from '../components/ConcertBanner.astro';

// Covers
import coverImage from '../assets/images/00-covers/front-cover-full-page.png';
import coverIssueA from '../assets/images/00-covers/cover-issue-a.png';

// Cover spread (Issue B: back + front cover) for the hero
import coverSpread from '../assets/images/home/cover-spread-b.jpg';

// Contents images
import imgDacostaEssay from '../assets/images/06-dacosta-picture-essay-artworks/dacosta-memory-v-1982-acrylic-collage-wax-crayon.jpg';
import imgComic from '../assets/images/10-comic-strip/comic-strip-sara-azad-ponta-delgada.png';

// Playlist backgrounds
import imgPlaylistSoundOfBlue from '../assets/images/03-azorean-blues-conversation/azores-landscape-opa-collective-playlist.jpg';
import imgPlaylistAzoreanBlues from '../assets/images/03-azorean-blues-conversation/romeu-bairos-viola-da-terra-close-up.jpg';

// Map background
import imgMapRuins from '../assets/images/misc/ilheu-map-ruins-clean.png';

const edition = await getEntry('editions', 'edition-2');
const purchaseUrl = edition?.data.purchase_url ?? '#';
const accentColour = '#1B3A5C';

// Previous issue (Azores) — sold out, no link
const allEditions = await getCollection('editions');
const previousIssue = allEditions.find((e) => e.data.status === 'archive');

// Five Conversations — card data for the new homepage row
const conversationCards = [
  { num: 1, category: 'Art', title: 'António Dacosta and his Paris Blues', a: 'Urbano Resendes', b: 'Arlete Alves da Silva', href: '/conversations/dacosta' },
  { num: 2, category: 'Writing', title: 'What’s the point trying to understand a soul?', a: 'Maria Brandão', b: 'Leïla Slimani', href: '/conversations/slimani' },
  { num: 3, category: 'Music', title: 'Azorean Blues', a: 'Diogo Lima', b: 'Romeu Bairos', href: '/conversations/azorean-blues' },
  { num: 4, category: 'Architecture', title: 'The Pool at the Edge of the World', a: 'Ilhéu Atelier', b: 'José António Barbosa', href: '/conversations/pool' },
  { num: 5, category: 'Environment', title: 'Blue Azores', a: 'Adriano Quintela', b: 'Bernardo Brito e Abreu', href: '/conversations/blue-azores' },
];

const supplementary = [
  { type: 'Playlist', title: 'Opa Collective on The Colour Blue', pages: '10–11', href: '/playlists/sound-of-blue' },
  { type: 'Picture Essay', title: 'The Blues of Antonio Dacosta', contributors: 'Urbano Resendes', pages: '28–49', image: imgDacostaEssay, alt: 'Dacosta, Memory V, 1982, acrylic, collage, wax crayon' },
  { type: 'Playlist', title: 'Azorean Blues', pages: '77–79', href: '/playlists/azorean-blues' },
  { type: 'Map', title: 'Ruins of the Azores', contributors: 'Ilheu Atelier', pages: '92–93' },
  { type: 'Comic Strip', title: 'Out of Control in Ponta Delgada', contributors: 'Sara Azad', pages: '112', image: imgComic, alt: 'Comic strip by Sara Azad, Out of Control in Ponta Delgada' },
  { type: 'Prose', title: 'Swimming Pools: Black and Blue — A Short Story of Unravelling in Water', contributors: 'Kathleen McCaul', pages: '114–121' },
];
---

<BaseLayout
  title="Issue B: The Colour Blue — Ilhéu Magazine"
  description="Issue B of Ilhéu Magazine — 'The Colour Blue'. Conversations, prose, photography and design from the Azores."
  fullBleed={true}
>

  <!-- One-off event promotion — sticky bar + ticket drawer (self-retiring) -->
  <ConcertBanner />

  <!-- ═══════════════════════════════════════════
       HERO — Issue B cover spread (from the layout PDF)
       ═══════════════════════════════════════════ -->
  <section class="relative bg-[#F2EEE4] pt-28 md:pt-36 lg:pt-40 pb-16 md:pb-24">
    <div class="max-w-6xl mx-auto px-6">

      <p class="hp-rise font-kicker text-sm sm:text-base text-[#E5392B] flex items-center gap-8 mb-7 md:mb-10">
        <span>Issue B</span>
        <span>Spring 2026</span>
      </p>

      <a
        href={purchaseUrl}
        aria-label="Buy Issue B — The Colour Blue"
        class="hp-rise hp-rise-2 block group"
      >
        <Image
          src={coverSpread}
          alt="Ilhéu Issue B cover spread — ‘Conversations from the Atlantic’ and ‘Pure Blue’"
          class="w-full h-auto block motion-safe:transition-transform motion-safe:duration-[800ms] motion-safe:ease-out motion-safe:group-hover:-translate-y-1.5"
          widths={[800, 1200, 1800, 2400]}
          sizes="(max-width: 1152px) 100vw, 1100px"
          loading="eager"
        />
      </a>

      <div class="hp-rise hp-rise-3 grid md:grid-cols-2 gap-x-10 gap-y-9 items-start mt-10 md:mt-14">
        <div class="max-w-xl">
          <p class="font-display font-semibold text-xl sm:text-2xl leading-[1.35] text-[#1A5FC4]">
            Ilh&eacute;u is a magazine of conversations, design, art and writing, produced and published on the Azorean island of S&atilde;o Miguel. The people who make Ilh&eacute;u run on the sun, the wind and the rain of the Atlantic, and we do this work for everyone who loves beautiful stories, images and words.
          </p>

          <!-- Relocated TV clip — opens the centered RTP modal (kept below) -->
          <button
            type="button"
            id="rtp-trigger"
            class="group/rtp mt-7 inline-flex items-center gap-3 text-[#1A5FC4] hover:text-[#0f4796] transition-colors cursor-pointer"
            aria-label="Watch Pedro Norten explain Ilhéu on RTP1, 57 seconds"
          >
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-full border border-[#1A5FC4]/40 group-hover/rtp:bg-[#1A5FC4]/10 group-hover/rtp:border-[#1A5FC4]/70 transition-colors">
              <svg class="w-3.5 h-3.5 translate-x-px" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
            </span>
            <span class="font-kicker text-xs">On television &middot; &ldquo;What is Ilh&eacute;u?&rdquo; &middot; RTP1 &middot; 57s</span>
          </button>
        </div>

        <div class="md:justify-self-end md:pt-1">
          <a
            href={purchaseUrl}
            class="inline-block bg-[#1A5FC4] text-white font-display font-semibold text-lg sm:text-xl px-12 sm:px-16 py-4 hover:bg-[#0f4796] transition-colors duration-300"
          >
            Buy Issue B
          </a>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       THE “B” — Bluets quote, blue/green split
       ═══════════════════════════════════════════ -->
  <section class="hp-b relative overflow-hidden">
    <div class="grid grid-cols-1 md:grid-cols-2">
      <div class="bg-[#1A5FC4] flex items-end min-h-[56vh] md:min-h-[84vh] px-7 sm:px-14 lg:px-20 py-12 lg:py-20">
        <blockquote class="hp-rise max-w-md relative z-[1]">
          <p class="font-minion italic text-2xl sm:text-3xl lg:text-[2.6rem] leading-[1.3] text-[#CFE6D7]">
            And so I fell in love with a colour&thinsp;&ndash;&thinsp;in this case, the colour blue&thinsp;&ndash;&thinsp;as if falling under a spell, a spell I fought to stay under and get out from under, in turns.
          </p>
          <footer class="mt-6 font-minion text-lg sm:text-xl text-[#3CC489]">
            <span class="font-bold not-italic">Maggie Nelson,</span> <em>Bluets</em>
          </footer>
        </blockquote>
      </div>
      <div class="bg-[#12A06A] min-h-[34vh] md:min-h-[84vh]"></div>
    </div>
    <span aria-hidden="true" class="hp-bigB absolute font-mega text-[#1A5FC4] select-none pointer-events-none">B</span>
  </section>


  <!-- ═══════════════════════════════════════════
       FIVE CONVERSATIONS ON BLUE — card row
       ═══════════════════════════════════════════ -->
  <section class="bg-[#F2EEE4] pt-20 md:pt-28 lg:pt-32 pb-24 md:pb-32">
    <div class="max-w-6xl mx-auto px-6">

      <!-- ruler ticks -->
      <div class="grid grid-cols-5 mb-10 md:mb-16" aria-hidden="true">
        {Array.from({ length: 5 }).map(() => (
          <span class="block w-px h-16 md:h-28 bg-black/70 mx-auto"></span>
        ))}
      </div>

      <h2 class="font-display font-extrabold text-4xl sm:text-6xl lg:text-7xl leading-[0.95] text-[#111] mb-7">
        Five Conversations on Blue
      </h2>
      <p class="font-display text-lg sm:text-2xl lg:text-[1.75rem] leading-[1.3] text-[#222] max-w-4xl mb-16 md:mb-24">
        Five investigations into the least pure of all the colours &mdash; from the Paris blues of the painter Ant&oacute;nio Dacosta to the architectural ruin of a six-million-euro swimming pool, from Le&iuml;la Slimani on writer&rsquo;s block to Romeu Bairos on the viola da terra, all the way down to the underwater stillness of the Azorean marine park.
      </p>

      <div class="grid grid-cols-2 md:grid-cols-5 gap-x-6 gap-y-14">
        {conversationCards.map((c) => (
          <a
            href={c.href}
            aria-label={`Read conversation ${c.num}: ${c.title}`}
            class="hp-card group flex flex-col items-center text-center focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1A5FC4] outline-none"
          >
            <span class="block w-px h-12 md:h-20 bg-black/70 mb-7"></span>
            <span class="font-kicker text-[11px] text-black mb-3">Conversation</span>
            <span class="mb-3 flex items-center justify-center w-9 h-9 rounded-full border border-black font-display font-semibold text-sm text-black group-hover:bg-black group-hover:text-[#F2EEE4] transition-colors">
              {c.num}
            </span>
            <span class="font-kicker text-[11px] text-black/70 mb-4">{c.category}</span>
            <span class="hp-card-title text-black text-2xl sm:text-[1.7rem] leading-[0.9] mb-5">{c.title}</span>
            <span class="hp-pill mt-auto inline-flex flex-col items-center justify-center border border-black px-6 py-3.5 min-w-[8.5rem]">
              <span class="font-display text-[13px] leading-tight text-black/80">{c.a}</span>
              <span class="font-display font-bold text-sm leading-tight text-black">{c.b}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>



  <!-- ═══════════════════════════════════════════
       ALSO IN THIS ISSUE — INTRO
       ═══════════════════════════════════════════ -->
  <section class="bg-white border-t border-gray-100">
    <div class="max-w-6xl mx-auto px-6 pt-32 sm:pt-40 lg:pt-48 pb-20 sm:pb-28 lg:pb-32">
      <p class="font-inter text-xs uppercase tracking-[0.3em] text-gray-400 mb-8 lg:mb-10">
        Also in this issue
      </p>

      <h2 class="font-minion text-5xl sm:text-7xl lg:text-8xl leading-[1.0] text-gray-900 mb-10 lg:mb-14 max-w-4xl">
        Maps, playlists <em class="text-gray-400 font-normal">&amp; interludes</em>
      </h2>

      <div class="grid lg:grid-cols-12 gap-10 lg:gap-12">
        <p class="font-minion text-xl sm:text-2xl lg:text-3xl leading-[1.4] text-gray-700 lg:col-span-7 max-w-3xl">
          Threading between the conversations: a picture essay on Dacosta&rsquo;s late period, two playlists curated to set the issue&rsquo;s mood, a hand-drawn map of Azorean ruins, a comic strip from Ponta Delgada, and a short story by Kathleen McCaul. Interludes that hold the page between the louder voices.
        </p>
        <div class="lg:col-span-4 lg:col-start-9 lg:pt-2">
          <p class="font-inter text-[10px] uppercase tracking-[0.3em] text-gray-400 mb-5">
            In this section
          </p>
          <ul class="font-inter text-[11px] uppercase tracking-[0.25em] text-gray-700 space-y-3 leading-relaxed">
            <li>Picture Essay &nbsp;&mdash;&nbsp; Dacosta</li>
            <li>Playlist 01 &nbsp;&mdash;&nbsp; Opa Collective</li>
            <li>Map &nbsp;&mdash;&nbsp; Ruins of the Azores</li>
            <li>Playlist 02 &nbsp;&mdash;&nbsp; Azorean Blues</li>
            <li>Comic Strip &nbsp;&mdash;&nbsp; Sara Azad</li>
            <li>Prose &nbsp;&mdash;&nbsp; Kathleen McCaul</li>
          </ul>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       PICTURE ESSAY — full-bleed, mix-blend title
       ═══════════════════════════════════════════ -->
  <section class="relative bg-gray-900 group">
    <div class="relative h-[75vh] sm:h-[85vh] lg:h-screen overflow-hidden">
      <Image
        src={supplementary[1].image!}
        alt={supplementary[1].alt!}
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1800ms] ease-out motion-safe:group-hover:scale-[1.05]"
        widths={[1200, 1800, 2400]}
        sizes="100vw"
      />
      <div
        class="absolute inset-0 pointer-events-none"
        style="background: linear-gradient(to bottom, rgba(0,0,0,0.5) 0%, transparent 22%, transparent 60%, rgba(0,0,0,0.6) 100%);"
      ></div>

      <div class="absolute top-0 inset-x-0 p-6 sm:p-10 lg:p-14">
        <div class="max-w-6xl mx-auto">
          <p class="font-inter text-[10px] sm:text-[11px] font-bold uppercase tracking-[0.3em] text-white">
            Picture Essay &middot; pp. {supplementary[1].pages}
          </p>
        </div>
      </div>

      <div class="absolute bottom-0 inset-x-0 p-6 sm:p-10 lg:p-14 scroll-fade-center">
        <div class="max-w-6xl mx-auto">
          <h3 class="font-minion italic text-5xl sm:text-7xl lg:text-[9rem] leading-[0.95] text-white mb-6 sm:mb-8 max-w-5xl mix-blend-difference">
            {supplementary[1].title}
          </h3>
          <p class="font-minion text-base sm:text-lg italic text-white/85">
            By {supplementary[1].contributors}
          </p>
          <p class="font-inter text-[10px] sm:text-[11px] uppercase tracking-[0.25em] text-white/55 mt-6">
            In the print edition
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       PLAYLISTS — paired record sleeves
       Each tile is a photograph (album-cover style)
       with a vinyl record overlay (grooves + label)
       and mix-blend-difference title.
       ═══════════════════════════════════════════ -->
  <section class="grid sm:grid-cols-2">

    {/* A-SIDE — Sound of Blue (Opa Collective landscape photograph) */}
    <a
      href={supplementary[0].href}
      class="block group h-[75vh] sm:h-[90vh] lg:h-screen relative overflow-hidden focus-visible:outline-4 focus-visible:-outline-offset-8 focus-visible:outline-white outline-none bg-gray-900"
      aria-label={`Playlist: ${supplementary[0].title}`}
    >
      {/* Cover photograph */}
      <Image
        src={imgPlaylistSoundOfBlue}
        alt="Azorean landscape, Opa Collective playlist companion photograph"
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-[2200ms] ease-out motion-safe:group-hover:scale-105"
        widths={[800, 1200, 1800]}
        sizes="(max-width: 640px) 100vw, 50vw"
      />

      {/* Dark overlay for readability */}
      <div class="absolute inset-0 bg-black/45 pointer-events-none"></div>

      {/* Vinyl grooves — dark rings over photo, rotate on hover */}
      <div
        class="absolute -right-1/4 -top-1/4 w-[160%] aspect-square rounded-full transition-transform duration-[3000ms] ease-out motion-safe:group-hover:rotate-[20deg] pointer-events-none"
        style="background: repeating-radial-gradient(circle at center, transparent 0 5px, rgba(0,0,0,0.35) 5px 6px, transparent 6px 12px, rgba(0,0,0,0.18) 12px 13px);"
        aria-hidden="true"
      ></div>

      {/* Centre label disc — record label */}
      <div
        class="absolute right-[16%] top-[16%] w-14 h-14 lg:w-20 lg:h-20 rounded-full flex items-center justify-center ring-1 ring-white/10"
        style={`background: ${accentColour};`}
        aria-hidden="true"
      >
        <div class="w-2 h-2 rounded-full bg-black"></div>
      </div>

      {/* A-SIDE micro-label + catalog */}
      <div class="absolute top-0 inset-x-0 p-6 sm:p-10 lg:p-14">
        <div class="flex items-baseline justify-between gap-4">
          <p class="font-inter text-[10px] sm:text-[11px] font-bold uppercase tracking-[0.4em] text-white">
            A-side &middot; 33⅓ rpm
          </p>
          <p class="font-inter text-[10px] sm:text-[11px] uppercase tracking-[0.3em] text-white/60">
            ILH&middot;B&middot;01
          </p>
        </div>
      </div>

      {/* Title block */}
      <div class="absolute bottom-0 inset-x-0 p-6 sm:p-10 lg:p-14 scroll-fade-center">
        <p class="font-inter text-[10px] sm:text-[11px] font-bold uppercase tracking-[0.3em] text-white mb-5">
          Playlist 01 &middot; pp. {supplementary[0].pages}
        </p>
        <h3 class="font-minion italic text-4xl sm:text-6xl lg:text-7xl leading-[0.95] text-white mb-6 sm:mb-8 max-w-xl mix-blend-difference">
          {supplementary[0].title}
        </h3>
        <span class="font-inter text-[11px] uppercase tracking-[0.3em] text-white inline-flex items-center gap-2 motion-safe:transition-all motion-safe:duration-500">
          Listen on Spotify
          <span class="inline-block motion-safe:transition-transform motion-safe:duration-500 motion-safe:group-hover:translate-x-2">&rarr;</span>
        </span>
      </div>
    </a>

    {/* B-SIDE — Azorean Blues (viola da terra close-up) */}
    <a
      href={supplementary[2].href}
      class="block group h-[75vh] sm:h-[90vh] lg:h-screen relative overflow-hidden focus-visible:outline-4 focus-visible:-outline-offset-8 focus-visible:outline-white outline-none bg-gray-900"
      aria-label={`Playlist: ${supplementary[2].title}`}
    >
      {/* Cover photograph */}
      <Image
        src={imgPlaylistAzoreanBlues}
        alt="Romeu Bairos playing viola da terra — close-up"
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-[2200ms] ease-out motion-safe:group-hover:scale-105"
        widths={[800, 1200, 1800]}
        sizes="(max-width: 640px) 100vw, 50vw"
      />

      <div class="absolute inset-0 bg-black/45 pointer-events-none"></div>

      <div
        class="absolute -left-1/4 -bottom-1/4 w-[160%] aspect-square rounded-full transition-transform duration-[3000ms] ease-out motion-safe:group-hover:-rotate-[20deg] pointer-events-none"
        style="background: repeating-radial-gradient(circle at center, transparent 0 5px, rgba(0,0,0,0.38) 5px 6px, transparent 6px 12px, rgba(0,0,0,0.2) 12px 13px);"
        aria-hidden="true"
      ></div>

      <div
        class="absolute left-[16%] bottom-[16%] w-14 h-14 lg:w-20 lg:h-20 rounded-full flex items-center justify-center ring-1 ring-white/10"
        style={`background: ${accentColour};`}
        aria-hidden="true"
      >
        <div class="w-2 h-2 rounded-full bg-black"></div>
      </div>

      <div class="absolute top-0 inset-x-0 p-6 sm:p-10 lg:p-14">
        <div class="flex items-baseline justify-between gap-4">
          <p class="font-inter text-[10px] sm:text-[11px] font-bold uppercase tracking-[0.4em] text-white">
            B-side &middot; 33⅓ rpm
          </p>
          <p class="font-inter text-[10px] sm:text-[11px] uppercase tracking-[0.3em] text-white/60">
            ILH&middot;B&middot;02
          </p>
        </div>
      </div>

      <div class="absolute bottom-0 inset-x-0 p-6 sm:p-10 lg:p-14 scroll-fade-center">
        <p class="font-inter text-[10px] sm:text-[11px] font-bold uppercase tracking-[0.3em] text-white mb-5">
          Playlist 02 &middot; pp. {supplementary[2].pages}
        </p>
        <h3 class="font-minion italic text-4xl sm:text-6xl lg:text-7xl leading-[0.95] text-white mb-6 sm:mb-8 max-w-xl mix-blend-difference">
          {supplementary[2].title}
        </h3>
        <span class="font-inter text-[11px] uppercase tracking-[0.3em] text-white inline-flex items-center gap-2 motion-safe:transition-all motion-safe:duration-500">
          Listen on Spotify
          <span class="inline-block motion-safe:transition-transform motion-safe:duration-500 motion-safe:group-hover:translate-x-2">&rarr;</span>
        </span>
      </div>
    </a>
  </section>


  <!-- ═══════════════════════════════════════════
       MAP — Ruins of the Azores
       Full-bleed designed map graphic on navy.
       ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden" style={`background-color: ${accentColour};`}>
    <div class="relative h-[75vh] sm:h-[85vh] lg:h-screen">

      <Image
        src={imgMapRuins}
        alt="Hand-drawn map of the nine Azorean islands marking notable ruins"
        class="absolute inset-0 w-full h-full object-cover"
        widths={[800, 1200, 1800, 2400]}
        sizes="100vw"
      />

      {/* Subtle bottom gradient to anchor the title */}
      <div
        class="absolute inset-0 pointer-events-none"
        style="background: linear-gradient(to bottom, transparent 0%, transparent 60%, rgba(0,0,0,0.35) 100%);"
      ></div>

      {/* Top — eyebrow + page numbers */}
      <div class="absolute top-0 inset-x-0 p-6 sm:p-10 lg:p-14">
        <div class="max-w-6xl mx-auto flex items-baseline justify-between gap-4">
          <p class="font-inter text-[10px] sm:text-[11px] font-bold uppercase tracking-[0.3em] text-white">
            Map &middot; 37&deg;N &mdash; 39&deg;N, 25&deg;W &mdash; 31&deg;W
          </p>
          <p class="font-inter text-[10px] sm:text-[11px] uppercase tracking-[0.3em] text-white/80">
            pp. {supplementary[3].pages}
          </p>
        </div>
      </div>

      {/* Bottom — title (mix-blend over navy → warm beige) */}
      <div class="absolute bottom-0 inset-x-0 p-6 sm:p-10 lg:p-14 scroll-fade-center">
        <div class="max-w-6xl mx-auto">
          <h3 class="font-minion italic text-5xl sm:text-7xl lg:text-[9rem] leading-[0.95] text-white mb-6 sm:mb-8 max-w-5xl mix-blend-difference">
            {supplementary[3].title}
          </h3>
          <p class="font-minion text-base sm:text-lg italic text-white/85">
            By {supplementary[3].contributors}
          </p>
          <p class="font-inter text-[10px] sm:text-[11px] uppercase tracking-[0.25em] text-white/55 mt-6">
            In the print edition
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       COMIC STRIP — full-bleed bedtime-story video
       ═══════════════════════════════════════════ -->
  <section class="relative bg-gray-900 group">
    <div class="relative h-[60vh] sm:h-[75vh] lg:h-[85vh] overflow-hidden">
      <video
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={supplementary[4].image!.src}
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1800ms] ease-out motion-safe:group-hover:scale-[1.05]"
      >
        <source src="/videos/bedtime-story.mp4" type="video/mp4" />
