---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

import coverIssueB from '../assets/images/00-covers/front-cover-full-page.png';
import coverIssueA from '../assets/images/00-covers/cover-issue-a.png';

const allEditions = await getCollection('editions');
const currentEdition = allEditions.find(e => e.data.status === 'current');
const archivedEditions = allEditions
  .filter(e => e.data.status === 'archive')
  .sort((a, b) => b.data.edition_number - a.data.edition_number);

let featuredArticle = null;
let featuredAuthor = null;
if (currentEdition) {
  const featured = await getCollection('articles', ({ id, data }) =>
    id.startsWith(currentEdition.id + '/') && data.featured === true
  );
  featuredArticle = featured[0] || null;
  if (featuredArticle) {
    featuredAuthor = await getEntry(featuredArticle.data.author);
  }
}
---

<BaseLayout
  title="Ilhéu Magazine"
  description="Ilhéu is a biannual literary and cultural magazine from the Azores."
>
  <!-- Hero: Issue B -->
  {currentEdition && (
    <section class="min-h-[85vh] flex items-center border-b border-gray-100">
      <div class="max-w-6xl mx-auto px-6 py-20 lg:py-28 w-full">
        <div class="lg:grid lg:grid-cols-12 lg:gap-16 lg:items-center">

          <!-- Text column -->
          <div class="lg:col-span-5 mb-14 lg:mb-0 text-center lg:text-left">
            <p class="text-xs uppercase tracking-[0.25em] text-gray-400 mb-6 font-inter">
              Issue B
            </p>
            <a href={`/editions/${currentEdition.id}`} class="block group">
              <h1
                class="font-cardo text-5xl sm:text-6xl lg:text-7xl leading-[1.05] text-gray-900 mb-5 group-hover:text-gray-600 transition-colors"
                style={currentEdition.data.accent_colour ? `color: ${currentEdition.data.accent_colour}` : ''}
              >
                {currentEdition.data.theme}
              </h1>
              <p class="font-cardo text-xl sm:text-2xl text-gray-400 mb-10 leading-relaxed">
                {currentEdition.data.title}
              </p>
            </a>
            <p class="font-inter text-sm text-gray-500 leading-relaxed mb-10 max-w-sm mx-auto lg:mx-0">
              A biannual literary and cultural magazine from the Azores. Essays, poetry, photography, and visual art in a beautiful printed edition.
            </p>
            <div class="flex flex-wrap items-center gap-4 justify-center lg:justify-start">
              {currentEdition.data.purchase_url && (
                <a
                  href={currentEdition.data.purchase_url}
                  class="inline-block bg-gray-900 text-white font-inter text-xs uppercase tracking-[0.2em] px-10 py-4 hover:bg-gray-700 transition-colors duration-300"
                >
                  Buy This Issue
                </a>
              )}
              <a
                href={`/editions/${currentEdition.id}`}
                class="inline-block border border-gray-300 text-gray-700 font-inter text-xs uppercase tracking-[0.2em] px-10 py-4 hover:border-gray-900 hover:text-gray-900 transition-colors duration-300"
              >
                Read More
              </a>
            </div>
          </div>

          <!-- Cover column -->
          <div class="lg:col-span-7 flex justify-center lg:justify-end">
            <div class="relative max-w-sm lg:max-w-md">
              <Image
                src={coverIssueB}
                alt={`Cover of Ilhéu Magazine Issue B: ${currentEdition.data.title}`}
                class="w-full shadow-2xl"
                widths={[400, 600, 800]}
                sizes="(max-width: 640px) 360px, (max-width: 1024px) 400px, 480px"
              />
              <div
                class="absolute -bottom-6 left-[10%] right-[10%] h-12 blur-2xl opacity-15 rounded-full -z-10"
                style={currentEdition.data.accent_colour
                  ? `background-color: ${currentEdition.data.accent_colour}`
                  : 'background-color: #333'}
              />
            </div>
          </div>

        </div>
      </div>
    </section>
  )}

  <!-- Featured Article -->
  {featuredArticle && featuredAuthor && (
    <section class="bg-gray-50 border-b border-gray-100">
      <div class="max-w-2xl mx-auto px-6 py-20 lg:py-24">
        <p class="text-xs uppercase tracking-[0.25em] text-gray-400 mb-8 font-inter">
          From This Issue
        </p>
        <a href={`/articles/${featuredArticle.id}`} class="block group mb-8">
          <h2 class="font-cardo text-3xl sm:text-4xl lg:text-5xl text-gray-900 mb-6 group-hover:text-gray-600 transition-colors leading-snug">
            {featuredArticle.data.title}
          </h2>
          {featuredArticle.data.excerpt && (
            <p class="font-inter text-gray-500 text-base lg:text-lg leading-relaxed">
              {featuredArticle.data.excerpt}
            </p>
          )}
        </a>
        <p class="font-inter text-sm text-gray-400">
          By{' '}
          <a
            href={`/contributors/${featuredAuthor.id}`}
            class="text-gray-700 underline underline-offset-4 decoration-gray-300 hover:text-gray-900 hover:decoration-gray-500 transition-colors"
          >
            {featuredAuthor.data.name}
          </a>
        </p>
      </div>
    </section>
  )}

  <!-- Issue A: Mirrored hero -->
  {archivedEditions.length > 0 && archivedEditions[0] && (
    <section class="min-h-[85vh] flex items-center">
      <div class="max-w-6xl mx-auto px-6 py-20 lg:py-28 w-full">
        <div class="lg:grid lg:grid-cols-12 lg:gap-16 lg:items-center">

          <!-- Cover column (LEFT) -->
          <div class="lg:col-span-7 flex justify-center lg:justify-start mb-14 lg:mb-0">
            <div class="relative max-w-sm lg:max-w-md">
              <Image
                src={coverIssueA}
                alt={`Cover of Ilhéu Magazine Issue A: ${archivedEditions[0].data.title}`}
                class="w-full shadow-2xl"
                widths={[400, 600, 800]}
                sizes="(max-width: 640px) 360px, (max-width: 1024px) 400px, 480px"
              />
              <div
                class="absolute -bottom-6 left-[10%] right-[10%] h-12 blur-2xl opacity-15 rounded-full -z-10"
                style={archivedEditions[0].data.accent_colour
                  ? `background-color: ${archivedEditions[0].data.accent_colour}`
                  : 'background-color: #333'}
              />
            </div>
          </div>

          <!-- Text column (RIGHT) -->
          <div class="lg:col-span-5 text-center lg:text-left">
            <p class="text-xs uppercase tracking-[0.25em] text-gray-400 mb-6 font-inter">
              Issue A
            </p>
            <a href={`/editions/${archivedEditions[0].id}`} class="block group">
              <h2
                class="font-cardo text-5xl sm:text-6xl lg:text-7xl leading-[1.05] text-gray-900 mb-5 group-hover:text-gray-600 transition-colors"
                style={archivedEditions[0].data.accent_colour ? `color: ${archivedEditions[0].data.accent_colour}` : ''}
              >
                {archivedEditions[0].data.theme}
              </h2>
              <p class="font-cardo text-xl sm:text-2xl text-gray-400 mb-10 leading-relaxed">
                {archivedEditions[0].data.title}
              </p>
            </a>
            <div class="flex flex-wrap items-center gap-4 justify-center lg:justify-start">
              {archivedEditions[0].data.purchase_url && (
                <a
                  href={archivedEditions[0].data.purchase_url}
                  class="inline-block bg-gray-900 text-white font-inter text-xs uppercase tracking-[0.2em] px-10 py-4 hover:bg-gray-700 transition-colors duration-300"
                >
                  Buy This Issue
                </a>
              )}
              <a
                href={`/editions/${archivedEditions[0].id}`}
                class="inline-block border border-gray-300 text-gray-700 font-inter text-xs uppercase tracking-[0.2em] px-10 py-4 hover:border-gray-900 hover:text-gray-900 transition-colors duration-300"
              >
                Read More
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>
  )}
</BaseLayout>
