---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleNav from '../../components/ArticleNav.astro';
---

<BaseLayout
  title="The Sound of Blue — Ilhéu Magazine"
  description="A playlist curated by Oscar Opoku-Banful Taylor of the Jokkoo Collective, exploring the colour blue through sound. A companion piece to Ilhéu Magazine Issue B."
>

  <div class="min-h-screen" style="background-color: #0f0f23;">

    <ArticleNav dark next={{ label: "Dacosta", href: "/conversations/dacosta" }} />

    <!-- Header -->
    <section class="pt-24 md:pt-32 pb-12">
      <div class="max-w-3xl mx-auto px-6">

        <p class="font-inter text-xs tracking-[0.25em] uppercase text-indigo-400/70 mb-8">
          Playlist &mdash; Issue B
        </p>

        <h1 class="font-cardo text-4xl sm:text-5xl lg:text-6xl leading-[1.1] text-white mb-4">
          The Sound of Blue
        </h1>

        <p class="font-cardo text-xl sm:text-2xl text-indigo-300/60 mb-10 leading-snug">
          Opa Collective on The Colour Blue
        </p>

        <p class="font-inter text-sm text-gray-400 leading-relaxed max-w-2xl mb-4">
          Curated by <span class="text-gray-300">Oscar Opoku-Banful Taylor</span>, part of the Jokkoo Collective based in Barcelona, who came to the Azores as part of Walk&amp;Talk Biennial.
        </p>

        <p class="font-inter text-sm text-gray-500 leading-relaxed max-w-2xl">
          Oscar curated this playlist as a companion piece to his contribution to Ilh&eacute;u Magazine Issue B, exploring the colour blue through sound &mdash; from Steve Reich&rsquo;s minimalism to King Tubby&rsquo;s dub, from Coltrane&rsquo;s spiritual jazz to Milton Nascimento&rsquo;s Brazilian soul.
        </p>

      </div>
    </section>

    <!-- Spotify Embed -->
    <section class="pb-16">
      <div class="max-w-3xl mx-auto px-6">
        <iframe
          style="border-radius:12px"
          src="https://open.spotify.com/embed/playlist/3svKj9CHIZcVEAS1ljOT5j?utm_source=generator&theme=0"
          width="100%"
          height="600"
          frameBorder="0"
          allowfullscreen=""
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
        ></iframe>
      </div>
    </section>

    <!-- Footer links -->
    <section class="pb-24 md:pb-32">
      <div class="max-w-3xl mx-auto px-6">
        <div class="border-t border-white/10 pt-10 space-y-4">
          <p class="font-inter text-sm text-gray-500">
            Read the full interview in <span class="text-gray-400">Ilh&eacute;u Magazine Issue B</span>.
          </p>
          <a
            href="/editions/edition-2"
            class="inline-block font-inter text-sm text-indigo-400 hover:text-indigo-300 transition-colors duration-300"
          >
            &larr; Back to Issue B
          </a>
        </div>
      </div>
    </section>

    <ArticleNav dark next={{ label: "Dacosta", href: "/conversations/dacosta" }} />

  </div>

</BaseLayout>
