---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

import heroImage from '../assets/images/08-marco-costa-photography/aerial-blue-ocean-wave-marco-costa.jpg';
import coverIssueA from '../assets/images/00-covers/cover-issue-a.png';

const allEditions = await getCollection('editions');
const currentEdition = allEditions.find(e => e.data.status === 'current');
const archivedEditions = allEditions
  .filter(e => e.data.status === 'archive')
  .sort((a, b) => b.data.edition_number - a.data.edition_number);

let featuredArticle = null;
let featuredAuthor = null;
if (currentEdition) {
  const featured = await getCollection('articles', ({ id, data }) =>
    id.startsWith(currentEdition.id + '/') && data.featured === true
  );
  featuredArticle = featured[0] || null;
  if (featuredArticle) {
    featuredAuthor = await getEntry(featuredArticle.data.author);
  }
}
---

<BaseLayout
  title="Ilhéu Magazine"
  description="Ilhéu is a biannual literary and cultural magazine from the Azores."
>
  {/* ───── Full-Bleed Cinematic Hero ───── */}
  <section class="relative min-h-screen flex items-end overflow-hidden">
    {/* Background image — edge to edge, full viewport */}
    <Image
      src={heroImage}
      alt="Aerial view of a deep blue ocean wave breaking off the Azores coast"
      class="absolute inset-0 w-full h-full object-cover"
      widths={[800, 1200, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      quality={85}
    />

    {/* Dark gradient overlay — heavier at bottom for text legibility */}
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>

    {/* Hero content — pinned to bottom of viewport */}
    <div class="relative z-10 max-w-6xl mx-auto px-6 pb-16 lg:pb-24 w-full">
      {currentEdition ? (
        <div class="max-w-3xl">
          <p class="font-inter text-xs sm:text-sm uppercase tracking-[0.25em] text-white/70 mb-4">
            Issue B &mdash; {currentEdition.data.title}
          </p>
          <a href={`/editions/${currentEdition.id}`} class="block group">
            <h1 class="font-cardo text-5xl sm:text-6xl lg:text-8xl text-white leading-[1.05] mb-6 group-hover:text-white/80 transition-colors">
              {currentEdition.data.theme}
            </h1>
          </a>
          <p class="font-inter text-base sm:text-lg text-white/60 max-w-xl mb-10 leading-relaxed">
            A biannual literary and cultural magazine from the Azores.
          </p>
          {currentEdition.data.purchase_url && (
            <a
              href={currentEdition.data.purchase_url}
              class="inline-block font-inter text-sm uppercase tracking-[0.2em] text-white border border-white/60 px-8 py-4 hover:bg-white hover:text-gray-900 transition-all duration-300"
            >
              Buy This Issue
            </a>
          )}
        </div>
      ) : (
        <div class="max-w-3xl">
          <h1 class="font-cardo text-5xl sm:text-6xl lg:text-8xl text-white leading-[1.05] mb-6">
            Ilh&eacute;u
          </h1>
          <p class="font-inter text-base sm:text-lg text-white/60 max-w-xl leading-relaxed">
            A biannual literary and cultural magazine from the Azores.
          </p>
        </div>
      )}
    </div>

    {/* Scroll indicator */}
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 hidden lg:block">
      <div class="w-px h-10 bg-white/30 animate-pulse"></div>
    </div>
  </section>

  {/* ───── Featured Article ───── */}
  {featuredArticle && featuredAuthor && (
    <section class="bg-white">
      <div class="max-w-3xl mx-auto px-6 py-20 lg:py-28">
        <p class="font-inter text-xs uppercase tracking-[0.25em] text-gray-400 mb-10">
          Featured
        </p>
        <a href={`/articles/${featuredArticle.id}`} class="block group mb-8">
          <h2 class="font-cardo text-3xl sm:text-4xl lg:text-5xl text-gray-900 leading-snug mb-6 group-hover:text-gray-500 transition-colors">
            {featuredArticle.data.title}
          </h2>
          <p class="font-inter text-gray-600 text-base lg:text-lg leading-relaxed max-w-2xl">
            {featuredArticle.data.excerpt}
          </p>
        </a>
        <p class="font-inter text-sm text-gray-500">
          By{' '}
          <a
            href={`/contributors/${featuredAuthor.id}`}
            class="text-gray-900 underline underline-offset-4 decoration-gray-300 hover:decoration-gray-900 transition-colors"
          >
            {featuredAuthor.data.name}
          </a>
        </p>
      </div>
    </section>
  )}

  {/* ───── Edition Archive ───── */}
  {archivedEditions.length > 0 && (
    <section class="bg-gray-50 border-t border-gray-200">
      <div class="max-w-6xl mx-auto px-6 py-20 lg:py-28">
        <div class="flex items-baseline justify-between mb-12">
          <h2 class="font-cardo text-2xl lg:text-3xl text-gray-900">
            Past Issues
          </h2>
          <a
            href="/editions"
            class="font-inter text-sm text-gray-500 underline underline-offset-4 decoration-gray-300 hover:decoration-gray-900 hover:text-gray-900 transition-colors"
          >
            View all issues
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10">
          {archivedEditions.map((edition) => (
            <a href={`/editions/${edition.id}`} class="group block">
              {edition.data.cover_image ? (
                <Image
                  src={edition.data.cover_image}
                  alt={`Cover of Ilhéu Magazine Issue A: ${edition.data.title}`}
                  class="w-full aspect-[3/4] object-cover mb-5 shadow-sm group-hover:shadow-lg transition-shadow duration-300"
                />
              ) : (
                <div
                  class="w-full aspect-[3/4] mb-5 flex items-center justify-center"
                  style={edition.data.accent_colour ? `background-color: ${edition.data.accent_colour}` : 'background-color: #333'}
                >
                  <span class="font-cardo text-white text-xl text-center px-4 leading-snug">
                    {edition.data.theme}
                  </span>
                </div>
              )}
              <p class="font-inter text-xs uppercase tracking-[0.2em] text-gray-400 mb-1">
                Issue A
              </p>
              <h3 class="font-cardo text-xl text-gray-900 group-hover:text-gray-500 transition-colors mb-1">
                {edition.data.title}
              </h3>
              <p class="font-inter text-sm text-gray-500">
                {edition.data.theme}
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
