---
// v131 — BOLD / IMAGE-FORWARD
// Full-screen cover hero, dense photo grid, large type, image-heavy editorial feel.
// Think Kinfolk meets Apartamento — the images do the talking.

import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

import coverIssueB from '../assets/images/00-covers/front-cover-full-page.png';
import coverIssueA from '../assets/images/00-covers/cover-issue-a.png';

import photoPool from '../assets/images/04-pool-at-edge-of-world-architecture/povoacao-pool-diving-platform-lanes-interior.jpg';
import photoLeila from '../assets/images/02-leila-slimani-conversation/leila-slimani-full-page-portrait-seated-outdoors.jpg';
import photoNightSky from '../assets/images/09-andrea-santolaya-photography/azores-night-sky-milky-way-andrea-santolaya.jpg';
import photoWave from '../assets/images/08-marco-costa-photography/aerial-blue-ocean-wave-marco-costa.jpg';
import photoCoast from '../assets/images/07-sandra-rocha-photography/sandra-rocha-azores-coastal-road-rock-formations.jpg';
import photoSurfer from '../assets/images/08-marco-costa-photography/azores-surfer-on-wave-marco-costa.jpg';
import photoPoolTile from '../assets/images/04-pool-at-edge-of-world-architecture/povoacao-pool-blue-tiled-wall-rust-detail.jpg';

const allEditions = await getCollection('editions');
const currentEdition = allEditions.find(e => e.data.status === 'current');
const archivedEditions = allEditions
  .filter(e => e.data.status === 'archive')
  .sort((a, b) => b.data.edition_number - a.data.edition_number);

let featuredArticle = null;
let featuredAuthor = null;
if (currentEdition) {
  const featured = await getCollection('articles', ({ id, data }) =>
    id.startsWith(currentEdition.id + '/') && data.featured === true
  );
  featuredArticle = featured[0] || null;
  if (featuredArticle) {
    featuredAuthor = await getEntry(featuredArticle.data.author);
  }
}
---

<BaseLayout
  title="Ilhéu Magazine"
  description="Ilhéu is a biannual literary and cultural magazine from the Azores."
>
  <!-- Hero: Full-viewport cover -->
  {currentEdition && (
    <section class="relative min-h-screen flex items-end overflow-hidden bg-gray-950">
      <div class="absolute inset-0 flex items-center justify-center">
        <Image
          src={coverIssueB}
          alt={`Cover of Ilhéu Magazine Issue B: ${currentEdition.data.title}`}
          class="h-[85vh] w-auto max-w-none"
          widths={[600, 900, 1200]}
          sizes="(max-width: 640px) 90vw, 50vw"
        />
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-gray-950 via-gray-950/30 to-transparent" />
      <div class="relative w-full max-w-7xl mx-auto px-6 pb-16 lg:pb-20">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8">
          <div>
            <p class="text-xs uppercase tracking-[0.3em] text-gray-400 mb-4 font-inter">
              Issue B — Now Available
            </p>
            <h1 class="font-cardo text-5xl sm:text-7xl lg:text-8xl text-white leading-[0.95]">
              {currentEdition.data.theme}
            </h1>
          </div>
          <div class="flex items-center gap-4 lg:pb-2">
            {currentEdition.data.purchase_url && (
              <a
                href={currentEdition.data.purchase_url}
                class="inline-block bg-white text-gray-900 font-inter text-xs uppercase tracking-[0.2em] px-10 py-4 hover:bg-gray-200 transition-colors duration-300"
              >
                Buy This Issue
              </a>
            )}
            <a
              href={`/editions/${currentEdition.id}`}
              class="inline-block border border-gray-500 text-gray-300 font-inter text-xs uppercase tracking-[0.2em] px-10 py-4 hover:border-white hover:text-white transition-colors duration-300"
            >
              Explore
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Photo mosaic -->
  <section class="grid grid-cols-2 lg:grid-cols-4 gap-0">
    <div class="aspect-square overflow-hidden">
      <Image
        src={photoWave}
        alt="Aerial view of Atlantic wave"
        class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
        widths={[400, 600]}
        sizes="(max-width: 1024px) 50vw, 25vw"
      />
    </div>
    <div class="aspect-square overflow-hidden">
      <Image
        src={photoLeila}
        alt="Leila Slimani portrait"
        class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
        widths={[400, 600]}
        sizes="(max-width: 1024px) 50vw, 25vw"
      />
    </div>
    <div class="aspect-square overflow-hidden">
      <Image
        src={photoPoolTile}
        alt="Abandoned pool tile detail"
        class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
        widths={[400, 600]}
        sizes="(max-width: 1024px) 50vw, 25vw"
      />
    </div>
    <div class="aspect-square overflow-hidden">
      <Image
        src={photoSurfer}
        alt="Azorean surfer on wave"
        class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
        widths={[400, 600]}
        sizes="(max-width: 1024px) 50vw, 25vw"
      />
    </div>
  </section>

  <!-- Featured Article — large and loud -->
  {featuredArticle && featuredAuthor && (
    <section class="bg-white">
      <div class="max-w-7xl mx-auto px-6 py-24 lg:py-32">
        <div class="lg:grid lg:grid-cols-2 lg:gap-20 lg:items-center">
          <div class="mb-12 lg:mb-0">
            <div class="aspect-[3/4] overflow-hidden">
              <Image
                src={photoPool}
                alt="Povoacao municipal pool, diving platform"
                class="w-full h-full object-cover"
                widths={[600, 900]}
                sizes="(max-width: 1024px) 100vw, 50vw"
              />
            </div>
          </div>
          <div>
            <p class="text-xs uppercase tracking-[0.25em] text-gray-400 mb-8 font-inter">
              From This Issue
            </p>
            <a href={`/articles/${featuredArticle.id}`} class="block group mb-10">
              <h2 class="font-cardo text-4xl sm:text-5xl lg:text-6xl text-gray-900 mb-8 group-hover:text-gray-500 transition-colors leading-[1.05]">
                {featuredArticle.data.title}
              </h2>
              {featuredArticle.data.excerpt && (
                <p class="font-inter text-gray-500 text-lg leading-relaxed">
                  {featuredArticle.data.excerpt}
                </p>
              )}
            </a>
            <p class="font-inter text-sm text-gray-400">
              By{' '}
              <a
                href={`/contributors/${featuredAuthor.id}`}
                class="text-gray-700 underline underline-offset-4 decoration-gray-300 hover:text-gray-900 transition-colors"
              >
                {featuredAuthor.data.name}
              </a>
            </p>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Full-bleed landscape -->
  <section class="relative h-[60vh] lg:h-[70vh] overflow-hidden">
    <Image
      src={photoCoast}
      alt="Azores coastal road and rock formations"
      class="w-full h-full object-cover"
      widths={[800, 1200, 1920]}
      sizes="100vw"
    />
  </section>

  <!-- Issue A — bold horizontal card -->
  {archivedEditions.length > 0 && archivedEditions[0] && (
    <section class="bg-white">
      <div class="max-w-7xl mx-auto px-6 py-24 lg:py-32">
        <div class="lg:grid lg:grid-cols-12 lg:gap-16 lg:items-center">

          <div class="lg:col-span-5 flex justify-center mb-14 lg:mb-0">
            <div class="relative max-w-sm w-full">
              <Image
                src={coverIssueA}
                alt={`Cover of Ilhéu Magazine Issue A: ${archivedEditions[0].data.title}`}
                class="w-full shadow-2xl"
                widths={[400, 600, 800]}
                sizes="(max-width: 640px) 360px, 400px"
              />
            </div>
          </div>

          <div class="lg:col-span-7">
            <p class="text-xs uppercase tracking-[0.25em] text-gray-400 mb-6 font-inter">
              Issue A
            </p>
            <a href={`/editions/${archivedEditions[0].id}`} class="block group">
              <h2
                class="font-cardo text-5xl sm:text-6xl lg:text-7xl leading-[1.05] text-gray-900 mb-5 group-hover:text-gray-500 transition-colors"
                style={archivedEditions[0].data.accent_colour ? `color: ${archivedEditions[0].data.accent_colour}` : ''}
              >
                {archivedEditions[0].data.theme}
              </h2>
              <p class="font-cardo text-xl sm:text-2xl text-gray-400 mb-10 leading-relaxed">
                {archivedEditions[0].data.title}
              </p>
            </a>
            <div class="flex flex-wrap items-center gap-4">
              {archivedEditions[0].data.purchase_url && (
                <a
                  href={archivedEditions[0].data.purchase_url}
                  class="inline-block bg-gray-900 text-white font-inter text-xs uppercase tracking-[0.2em] px-10 py-4 hover:bg-gray-700 transition-colors duration-300"
                >
                  Buy This Issue
                </a>
              )}
              <a
                href={`/editions/${archivedEditions[0].id}`}
                class="inline-block border border-gray-300 text-gray-700 font-inter text-xs uppercase tracking-[0.2em] px-10 py-4 hover:border-gray-900 hover:text-gray-900 transition-colors duration-300"
              >
                Read More
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Closing image: Night sky -->
  <section class="relative h-[50vh] lg:h-[60vh] overflow-hidden">
    <Image
      src={photoNightSky}
      alt="Azores night sky with Milky Way"
      class="w-full h-full object-cover"
      widths={[800, 1200, 1920]}
      sizes="100vw"
    />
    <div class="absolute inset-0 flex items-center justify-center">
      <p class="font-cardo text-3xl sm:text-5xl text-white/80 text-center px-6 drop-shadow-lg">
        Nine islands. One magazine.
      </p>
    </div>
  </section>
</BaseLayout>
