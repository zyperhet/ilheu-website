---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Colophon — Ilhéu Magazine"
  description="Credits and colophon for Ilhéu Magazine, Issue B."
>
  <section class="bg-[#2D3461] text-white min-h-screen">
    <div class="max-w-6xl mx-auto px-6 py-20 lg:py-28">

      <!-- Page title -->
      <h1 class="font-cardo text-3xl sm:text-4xl tracking-wide mb-16 lg:mb-20 text-white/90">
        Colophon
      </h1>

      <!-- Three-column grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-16 lg:gap-12">

        <!-- COLUMN 1 -->
        <div class="space-y-10">

          <div>
            <h2 class="font-inter text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-3">Editor</h2>
            <p class="font-inter text-sm leading-relaxed text-white/90">Kathleen McCaul</p>
          </div>

          <div>
            <h2 class="font-inter text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-3">Graphic Design</h2>
            <p class="font-inter text-sm leading-relaxed text-white/90">
              Júlia Garcia<br />
              <span class="text-white/50">Assisted by</span> Caetano Kühne
            </p>
          </div>

          <div>
            <h2 class="font-inter text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-3">Editorial Team</h2>
            <p class="font-inter text-sm leading-relaxed text-white/90">
              Andrea Santolaya, Filipe Moura, Kathleen McCaul, Júlia Garcia
            </p>
          </div>

          <div>
            <h2 class="font-inter text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-3">Contributors</h2>
            <p class="font-inter text-sm leading-relaxed text-white/90">
              Ilhéu Atelier: Afonso Botelho Santos and Rita Sampaio, Arlete Alves da Silva, Rui Brito and Galeria 111, Sara Azad, José António Barbosa, Romeu Bairos, Maria Brandão, Bernardo Brito e Abreu, Diogo Lima, Oscar Opoku-Banful Taylor, Adriano Quintela, Urbano Resendes, Leïla Slimani
            </p>
          </div>

          <div>
            <h2 class="font-inter text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-3">Photographers</h2>
            <p class="font-inter text-sm leading-relaxed text-white/90">
              Maria Abranches, Marina Cruz, Marco Costa, Pedro Duarte Jorge, Paulo Goulart, Nelson Raposo, Sandra Rocha, Andrea Santolaya
            </p>
          </div>

        </div>

        <!-- COLUMN 2 -->
        <div class="space-y-10">

          <div>
            <p class="font-inter text-sm leading-relaxed text-white/70 italic">
              The between-story photos are taken from the books <em>Atlântico 744</em>, by Marco Costa and <em>Azores Atlantic Surfers</em>.
            </p>
          </div>

          <div>
            <h2 class="font-inter text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-3">English Proof Reading</h2>
            <p class="font-inter text-sm leading-relaxed text-white/90">Jonathan Weil</p>
          </div>

          <div>
            <h2 class="font-inter text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-3">Portuguese Proof Reading</h2>
            <p class="font-inter text-sm leading-relaxed text-white/90">
              Pedro Arruda, Maria Brandão, Diogo Lima, Urbano Resendes
            </p>
          </div>

          <div>
            <h2 class="font-inter text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-3">Typography</h2>
            <p class="font-inter text-sm leading-relaxed text-white/90">Obviously, PT Serif Pro</p>
          </div>

          <div>
            <h2 class="font-inter text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-3">Paper</h2>
            <p class="font-inter text-sm leading-relaxed text-white/90">Munken Pure 100g</p>
          </div>

          <div>
            <h2 class="font-inter text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-3">Print and Finishing</h2>
            <p class="font-inter text-sm leading-relaxed text-white/90">Nova Gráfica</p>
          </div>

          <div>
            <h2 class="font-inter text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-3">Copies</h2>
            <p class="font-inter text-sm leading-relaxed text-white/90">1850</p>
          </div>

          <div>
            <h2 class="font-inter text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-3">ISBN</h2>
            <p class="font-inter text-sm leading-relaxed text-white/90">978-989-33-6588-5</p>
          </div>

          <div>
            <h2 class="font-inter text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-3">Legal Deposit</h2>
            <p class="font-inter text-sm leading-relaxed text-white/50">&mdash;</p>
          </div>

          <div>
            <h2 class="font-inter text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-3">With Special Thanks to</h2>
            <p class="font-inter text-sm leading-relaxed text-white/90">
              Dirk Mönkemöller, Jesse James, António Castro Freire, Catarina Ferreira, Arlete Alves da Silva, Urbano Resendes
            </p>
          </div>

        </div>

        <!-- COLUMN 3 -->
        <div class="space-y-10">

          <div>
            <p class="font-inter text-sm leading-relaxed text-white/90">
              Ilhéu Magazine<br />
              Issue B, Spring 2026<br />
              15 euros
            </p>
          </div>

          <div>
            <p class="font-inter text-sm leading-relaxed text-white/70">
              Ilhéu magazine is published and printed at Nova Gráfica, São Miguel, Azores, Rua de Encarnação, 21 Fajã de Baixo, 9500-513, Ponta Delgada.
            </p>
          </div>

          <div>
            <h2 class="font-inter text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-3">Contact</h2>
            <p class="font-inter text-sm leading-relaxed text-white/90">
              <a href="mailto:contact@ilheumagazine.com" class="underline underline-offset-4 decoration-white/30 hover:decoration-white/70 transition-colors">
                contact@ilheumagazine.com
              </a>
            </p>
            <p class="font-inter text-sm leading-relaxed text-white/90 mt-1">
              <a href="https://ilheumagazine.com" class="underline underline-offset-4 decoration-white/30 hover:decoration-white/70 transition-colors">
                ilheumagazine.com
              </a>
            </p>
            <p class="font-inter text-sm leading-relaxed text-white/90 mt-1">
              <a href="https://www.instagram.com/ilheumagazine" class="underline underline-offset-4 decoration-white/30 hover:decoration-white/70 transition-colors">
                @ilheumagazine
              </a>
            </p>
          </div>

        </div>

      </div>

    </div>
  </section>
</BaseLayout>
