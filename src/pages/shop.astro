---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// Surface editions that have a purchase URL — will be populated in Phase 3
const editions = await getCollection('editions');
const availableEditions = editions.filter((e) => e.data.purchase_url);

// Sort by edition number descending
availableEditions.sort((a, b) => b.data.edition_number - a.data.edition_number);
---

<BaseLayout title="Shop — Ilheu Magazine" description="Buy Ilhéu Magazine. Biannual print editions from the Azores.">
  <div class="max-w-3xl mx-auto px-6 py-16 md:py-24">

    <h1 class="font-cardo text-4xl md:text-5xl font-bold text-gray-900 mb-6">Shop</h1>

    {availableEditions.length > 0 ? (
      <div>
        <p class="text-lg text-gray-700 mb-10 leading-relaxed">
          Each issue of Ilhéu Magazine is printed in a limited run and ships worldwide. Order your copy below.
        </p>

        <ul class="space-y-8">
          {availableEditions.map((edition) => (
            <li class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-gray-100 pb-8">
              <div>
                <p class="text-xs font-medium uppercase tracking-widest text-gray-400 mb-0.5">
                  Edition {edition.data.edition_number}
                </p>
                <h2 class="font-cardo text-2xl font-bold text-gray-900">{edition.data.title}</h2>
                <p class="text-gray-500 italic">{edition.data.theme}</p>
              </div>
              <a
                href={edition.data.purchase_url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block shrink-0 bg-gray-900 text-white text-sm font-medium px-6 py-3 hover:bg-gray-700 transition-colors"
              >
                Buy Now
              </a>
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <div class="space-y-5 text-lg text-gray-700 leading-relaxed">
        <p>
          The Ilhéu Magazine shop is coming soon.
        </p>
        <p>
          We are a biannual print magazine from the Azores. Each issue is printed in a limited run and ships worldwide. Full purchasing will be available here in a future update.
        </p>
        <p class="text-base text-gray-500">
          In the meantime, you can follow us at{' '}
          <a
            href="https://www.instagram.com/ilheumagazine"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-700 underline underline-offset-2 hover:text-gray-900 transition-colors"
          >
            @ilheumagazine
          </a>{' '}
          or get in touch at{' '}
          <a
            href="mailto:hello@ilheumagazine.com"
            class="text-gray-700 underline underline-offset-2 hover:text-gray-900 transition-colors"
          >
            hello@ilheumagazine.com
          </a>
          .
        </p>
      </div>
    )}

  </div>
</BaseLayout>
