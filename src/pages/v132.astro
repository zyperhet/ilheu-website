---
// v132 — ULTRA MINIMALIST
// Maximum whitespace, typographic hierarchy, almost no images.
// Think COS, Acne Studios, or a printed chapbook cover.
// The restraint IS the design.

import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

import coverIssueB from '../assets/images/00-covers/front-cover-full-page.png';
import coverIssueA from '../assets/images/00-covers/cover-issue-a.png';

const allEditions = await getCollection('editions');
const currentEdition = allEditions.find(e => e.data.status === 'current');
const archivedEditions = allEditions
  .filter(e => e.data.status === 'archive')
  .sort((a, b) => b.data.edition_number - a.data.edition_number);

let featuredArticle = null;
let featuredAuthor = null;
if (currentEdition) {
  const featured = await getCollection('articles', ({ id, data }) =>
    id.startsWith(currentEdition.id + '/') && data.featured === true
  );
  featuredArticle = featured[0] || null;
  if (featuredArticle) {
    featuredAuthor = await getEntry(featuredArticle.data.author);
  }
}
---

<BaseLayout
  title="Ilhéu Magazine"
  description="Ilhéu is a biannual literary and cultural magazine from the Azores."
>
  <!-- Hero: Pure typographic -->
  <section class="min-h-screen flex flex-col justify-center items-center px-6">
    <div class="text-center max-w-xl">
      <h1 class="font-cardo text-7xl sm:text-8xl lg:text-9xl text-gray-900 leading-[0.9] mb-8">
        Ilhéu
      </h1>
      <div class="w-12 h-px bg-gray-300 mx-auto mb-8" />
      <p class="font-inter text-sm text-gray-400 tracking-[0.2em] uppercase">
        A biannual magazine from the Azores
      </p>
    </div>
  </section>

  <!-- Current issue: Single small cover, centered -->
  {currentEdition && (
    <section class="pb-32 lg:pb-44">
      <div class="max-w-xl mx-auto px-6 text-center">
        <p class="text-[10px] uppercase tracking-[0.35em] text-gray-400 mb-16 font-inter">
          Current Issue
        </p>
        <a href={`/editions/${currentEdition.id}`} class="block group mb-16">
          <div class="mx-auto w-48 sm:w-56 mb-16">
            <Image
              src={coverIssueB}
              alt={`Cover of Issue B: ${currentEdition.data.title}`}
              class="w-full shadow-lg group-hover:shadow-xl transition-shadow duration-500"
              widths={[300, 500]}
              sizes="224px"
            />
          </div>
          <h2
            class="font-cardo text-4xl sm:text-5xl text-gray-900 mb-4 group-hover:text-gray-500 transition-colors leading-tight"
            style={currentEdition.data.accent_colour ? `color: ${currentEdition.data.accent_colour}` : ''}
          >
            {currentEdition.data.theme}
          </h2>
          <p class="font-cardo text-xl text-gray-400">
            {currentEdition.data.title}
          </p>
        </a>
        {currentEdition.data.purchase_url && (
          <a
            href={currentEdition.data.purchase_url}
            class="inline-block font-inter text-xs uppercase tracking-[0.2em] text-gray-500 border-b border-gray-300 pb-1 hover:text-gray-900 hover:border-gray-900 transition-colors"
          >
            Order a copy
          </a>
        )}
      </div>
    </section>
  )}

  <!-- Thin rule -->
  <div class="max-w-xs mx-auto">
    <div class="h-px bg-gray-200" />
  </div>

  <!-- Featured Article: Text only, generous space -->
  {featuredArticle && featuredAuthor && (
    <section class="py-32 lg:py-44">
      <div class="max-w-lg mx-auto px-6 text-center">
        <p class="text-[10px] uppercase tracking-[0.35em] text-gray-400 mb-12 font-inter">
          Featured
        </p>
        <a href={`/articles/${featuredArticle.id}`} class="block group mb-8">
          <h2 class="font-cardo text-3xl sm:text-4xl text-gray-900 mb-6 group-hover:text-gray-500 transition-colors leading-snug">
            {featuredArticle.data.title}
          </h2>
          {featuredArticle.data.excerpt && (
            <p class="font-inter text-gray-400 text-base leading-relaxed">
              {featuredArticle.data.excerpt}
            </p>
          )}
        </a>
        <p class="font-inter text-xs text-gray-400">
          <a
            href={`/contributors/${featuredAuthor.id}`}
            class="text-gray-500 hover:text-gray-900 transition-colors"
          >
            {featuredAuthor.data.name}
          </a>
        </p>
      </div>
    </section>
  )}

  <!-- Thin rule -->
  <div class="max-w-xs mx-auto">
    <div class="h-px bg-gray-200" />
  </div>

  <!-- Issue A: One line, understated -->
  {archivedEditions.length > 0 && archivedEditions[0] && (
    <section class="py-32 lg:py-44">
      <div class="max-w-xl mx-auto px-6 text-center">
        <p class="text-[10px] uppercase tracking-[0.35em] text-gray-400 mb-16 font-inter">
          Previous Issue
        </p>
        <a href={`/editions/${archivedEditions[0].id}`} class="block group mb-16">
          <div class="mx-auto w-40 sm:w-48 mb-16">
            <Image
              src={coverIssueA}
              alt={`Cover of Issue A: ${archivedEditions[0].data.title}`}
              class="w-full shadow-lg group-hover:shadow-xl transition-shadow duration-500"
              widths={[300, 500]}
              sizes="192px"
            />
          </div>
          <h2
            class="font-cardo text-4xl sm:text-5xl text-gray-900 mb-4 group-hover:text-gray-500 transition-colors leading-tight"
            style={archivedEditions[0].data.accent_colour ? `color: ${archivedEditions[0].data.accent_colour}` : ''}
          >
            {archivedEditions[0].data.theme}
          </h2>
          <p class="font-cardo text-xl text-gray-400">
            {archivedEditions[0].data.title}
          </p>
        </a>
        {archivedEditions[0].data.purchase_url && (
          <a
            href={archivedEditions[0].data.purchase_url}
            class="inline-block font-inter text-xs uppercase tracking-[0.2em] text-gray-500 border-b border-gray-300 pb-1 hover:text-gray-900 hover:border-gray-900 transition-colors"
          >
            Order a copy
          </a>
        )}
      </div>
    </section>
  )}

  <!-- Closing: Pure text -->
  <section class="pb-32 lg:pb-44">
    <div class="text-center px-6">
      <p class="font-cardo text-lg text-gray-300 italic">
        Essays, poetry, photography, and visual art
      </p>
    </div>
  </section>
</BaseLayout>
